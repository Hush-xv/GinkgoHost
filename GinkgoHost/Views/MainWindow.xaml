<ui:FluentWindow x:Class="GinkgoHost.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="GinkgoHost · Ginkgo USB-I2C"
                 Width="1280" Height="780"
                 MinWidth="1040" MinHeight="640"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <ui:Button x:Name="BtnNavToggle" Content="☰" Click="BtnNavToggle_Click"
                       Width="34" Height="30" Margin="10,8,0,0"
                       VerticalAlignment="Top" HorizontalAlignment="Left"
                       Background="Transparent" BorderThickness="0" FontSize="15"
                       ToolTip="显示/隐藏导航栏" />
            <ui:TitleBar Grid.Column="1" Title="GinkgoHost · Ginkgo USB-I2C" />
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavCol" Width="216" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="Nav" Margin="10,0,0,10" SelectionChanged="Nav_SelectionChanged">
                <ListBoxItem IsSelected="True">
                    <StackPanel Orientation="Horizontal" Margin="4">
                        <ui:SymbolIcon Symbol="Home24" Margin="0,0,10,0" />
                        <TextBlock Text="设备" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal" Margin="4">
                        <ui:SymbolIcon Symbol="PlugConnected24" Margin="0,0,10,0" />
                        <TextBlock Text="I2C" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal" Margin="4">
                        <ui:SymbolIcon Symbol="Code24" Margin="0,0,10,0" />
                        <TextBlock Text="控制台" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal" Margin="4">
                        <ui:SymbolIcon Symbol="Settings24" Margin="0,0,10,0" />
                        <TextBlock Text="设置" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>
            <ContentControl x:Name="PageHost" Grid.Column="1" Margin="6,0,10,10" />
        </Grid>

        <Border Grid.Row="2" Padding="14,6" BorderThickness="0,1,0,0"
                BorderBrush="#20808080" Background="#20808080">
            <DockPanel>
                <StackPanel Orientation="Horizontal">
                    <Ellipse x:Name="DotState" Width="10" Height="10" Fill="Gray"
                             VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock x:Name="TxtState" Text="Connect to a Host Adapter" VerticalAlignment="Center" />
                    <TextBlock x:Name="TxtAdapterInfo" Margin="18,0,0,0" Opacity="0.6" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="TxtLastTx" DockPanel.Dock="Right" HorizontalAlignment="Right"
                           Opacity="0.6" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</ui:FluentWindow>

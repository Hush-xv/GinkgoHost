<ui:FluentWindow x:Class="GinkgoHost.Views.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="GinkgoHost · Ginkgo USB-I2C"
                 Icon="pack://application:,,,/Assets/GinkgoHost.ico"
                 Width="1320" Height="820"
                 MinWidth="1040" MinHeight="640"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowStartupLocation="Manual"
                 SizeChanged="MainWindow_SizeChanged"
                 PreviewKeyDown="MainWindow_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <ui:Button x:Name="BtnNavToggle" Content="☰" Click="BtnNavToggle_Click"
                       Width="34" Height="30" Margin="10,8,0,0"
                       VerticalAlignment="Top" HorizontalAlignment="Left"
                       Background="Transparent" BorderThickness="0" FontSize="15"
                       ToolTip="显示/隐藏导航栏 · Ctrl+1–5 切换页面" />
            <ui:TitleBar Grid.Column="1" Title="GinkgoHost · Ginkgo USB-I2C">
                <!-- 使用 TitleBar 原生 Header 槽位，标题、状态和系统按钮在 DPI/窗口变化时由控件统一排版。 -->
                <ui:TitleBar.Header>
                    <Border Margin="14,0,0,0" Padding="9,4" CornerRadius="8" IsHitTestVisible="False"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DotHeaderState" Width="7" Height="7" Fill="Gray" VerticalAlignment="Center" Margin="0,0,6,0" />
                            <TextBlock x:Name="TxtHeaderState" Text="未连接" FontSize="11" Opacity="0.76" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" MaxWidth="220" />
                        </StackPanel>
                    </Border>
                </ui:TitleBar.Header>
            </ui:TitleBar>
        </Grid>

        <Grid Grid.Row="1" Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="NavCol" Width="204" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Border Margin="12,0,8,12" Padding="10,14" Style="{StaticResource SubtleSurfaceStyle}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="8,0,8,16">
                    <TextBlock Text="工作台" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="连接设备 · 配置总线 · 执行事务" FontSize="11" Opacity="0.52" Margin="0,3,0,0" />
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Margin="0,12,0,0" Padding="10"
                        CornerRadius="10" Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="DotWorkspaceState" Width="10" Height="10" Fill="Gray"
                                     VerticalAlignment="Center" Margin="0,0,8,0" />
                            <StackPanel>
                                <TextBlock x:Name="TxtWorkspaceState" Text="未连接" FontWeight="SemiBold" />
                                <TextBlock x:Name="TxtWorkspaceDetail" Text="未检测到适配器"
                                           FontSize="11" Opacity="0.55" Margin="0,2,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </StackPanel>
                        <UniformGrid Rows="1" Margin="0,10,0,0">
                            <ui:Button x:Name="BtnWorkspaceConnect" Content="连接" Appearance="Primary"
                                       Click="BtnWorkspaceConnect_Click" Margin="0,0,3,0"
                                       MinHeight="34" ToolTip="自动扫描并连接已插入的适配器" />
                            <ui:Button x:Name="BtnWorkspaceDisconnect" Content="断开" IsEnabled="False"
                                       Click="BtnWorkspaceDisconnect_Click" Margin="3,0,0,0" MinHeight="34" />
                        </UniformGrid>
                    </StackPanel>
                </Border>
            <ListBox x:Name="Nav" SelectionChanged="Nav_SelectionChanged" Background="Transparent"
                     BorderThickness="0" HorizontalContentAlignment="Stretch">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="MinHeight" Value="44" />
                        <Setter Property="Margin" Value="0,3" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid>
                                        <!-- Fluent 导航选中指示条：3px 圆角强调条贴左缘，选中时出现 -->
                                        <Border x:Name="NavIndicator" Width="3" CornerRadius="1.5,1.5,1.5,1.5"
                                                HorizontalAlignment="Left" VerticalAlignment="Center" Height="18"
                                                Margin="-3,0,0,0" Background="{DynamicResource AccentFillColorDefaultBrush}"
                                                Visibility="Collapsed" />
                                        <Border x:Name="NavSurface" Background="{TemplateBinding Background}"
                                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                                CornerRadius="8">
                                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                                        </Border>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" /></Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="NavSurface" Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                                            <Setter TargetName="NavIndicator" Property="Visibility" Value="Visible" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="NavSurface" Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" /></Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBoxItem IsSelected="True">
                    <StackPanel Orientation="Horizontal" Margin="8,5">
                        <ui:SymbolIcon Symbol="Home24" Margin="0,0,10,0" />
                        <TextBlock Text="设备" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal" Margin="8,5">
                        <ui:SymbolIcon Symbol="PlugConnected24" Margin="0,0,10,0" />
                        <TextBlock Text="I²C" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal" Margin="8,5">
                        <ui:SymbolIcon Symbol="ArrowSyncCircle24" Margin="0,0,10,0" />
                        <TextBlock Text="从机" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal" Margin="8,5">
                        <ui:SymbolIcon Symbol="Code24" Margin="0,0,10,0" />
                        <TextBlock Text="控制台" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
                <ListBoxItem>
                    <StackPanel Orientation="Horizontal" Margin="8,5">
                        <ui:SymbolIcon Symbol="Settings24" Margin="0,0,10,0" />
                        <TextBlock Text="设置" VerticalAlignment="Center" />
                    </StackPanel>
                </ListBoxItem>
            </ListBox>
            </DockPanel>
            </Border>
            <!-- ContentControl 的内容对齐默认 Left/Top：页面会按自身期望高度排布，星型行拿不到剩余高度，
                 窗口底部常年空白，滚动页在内容超出时也不会出现滚动条。必须显式拉伸。 -->
            <ContentControl x:Name="PageHost" Grid.Column="1" Margin="10,0,20,12"
                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Grid>
    </Grid>
</ui:FluentWindow>

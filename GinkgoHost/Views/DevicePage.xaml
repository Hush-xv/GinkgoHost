<UserControl x:Class="GinkgoHost.Views.DevicePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:GinkgoHost.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12,8,12,20" MaxWidth="960" HorizontalAlignment="Left">

            <TextBlock Text="设备概览" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="查看当前适配器状态、能力与接口定义" Style="{StaticResource PageSubtitleStyle}" />

            <TextBlock Text="设备信息" Style="{StaticResource SectionTitleStyle}" />
            <ui:Card Margin="0,0,0,14" Padding="12,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Text="适配器" Opacity="0.65" Margin="0,0,32,8" />
                    <TextBlock x:Name="TxtModel" Grid.Column="1" Text="Ginkgo VTG200A USB-I2C（型号待确认）" />
                    <TextBlock Text="序列号" Grid.Row="1" Opacity="0.65" Margin="0,0,32,8" />
                    <TextBlock x:Name="TxtSerial" Grid.Row="1" Grid.Column="1" FontFamily="Consolas" Text="—" />
                    <TextBlock Text="固件" Grid.Row="2" Opacity="0.65" Margin="0,0,32,8" />
                    <TextBlock x:Name="TxtFirmware" Grid.Row="2" Grid.Column="1" FontFamily="Consolas" Text="—" />
                    <TextBlock Text="驱动" Grid.Row="3" Opacity="0.65" Margin="0,0,32,8" />
                    <TextBlock x:Name="TxtDriver" Grid.Row="3" Grid.Column="1" Text="—" />
                    <TextBlock Text="适配器数" Grid.Row="4" Opacity="0.65" Margin="0,0,32,8" />
                    <TextBlock x:Name="TxtCount" Grid.Row="4" Grid.Column="1" Text="—" />
                    <TextBlock Text="状态" Grid.Row="5" Opacity="0.65" Margin="0,0,32,8" />
                    <TextBlock x:Name="TxtDevState" Grid.Row="5" Grid.Column="1" Text="未连接" />
                    <TextBlock Text="能力" Grid.Row="6" Opacity="0.65" Margin="0,0,32,0" />
                    <TextBlock Grid.Row="6" Grid.Column="1" TextWrapping="Wrap"
                               Text="I²C Master · SMBus · PMBus" />
                    <TextBlock Grid.Row="7" Grid.Column="1" Text="I²C 实现：硬件外设 / GPIO 模拟 · I²C Slave 暂未支持"
                               FontSize="11" Opacity="0.45" Margin="0,6,0,0" />
                    <!-- 未发现适配器时的行动指引（D12）：扫描内建于左下「连接」动作 -->
                    <TextBlock x:Name="TxtAdapterHint" Grid.Row="8" Grid.ColumnSpan="2" Margin="0,10,0,0" FontSize="11"
                               Foreground="#E8C87A" TextWrapping="Wrap"
                               Text="未发现兼容适配器 · 请检查 USB 连接，插入后点击左下「连接」自动扫描并连接" />
                </Grid>
            </ui:Card>

            <TextBlock x:Name="TxtPinoutTitle" Text="接口与引脚" Style="{StaticResource SectionTitleStyle}" />
            <ui:Card Padding="12,10">
                <StackPanel>
                    <!-- 静态引脚说明（D7）：主说明 + 次级说明 + 右侧图例，不再拼成一行 -->
                    <DockPanel Margin="0,0,0,4">
                        <TextBlock DockPanel.Dock="Right" Text="● 信号线　○ 电源 / 地" FontSize="12"
                                   Foreground="#9FB8D8" VerticalAlignment="Center" />
                        <TextBlock Text="静态引脚定义" FontSize="12" FontWeight="SemiBold" />
                    </DockPanel>
                    <TextBlock Text="驱动不提供实时电平 · 通道信号列表，接线以设备丝印为准"
                               FontSize="11" Opacity="0.55" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition /><ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Border Margin="0,0,6,0" Padding="10" CornerRadius="6"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="通道 0" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <views:PinDot Signal="SDA" />
                                <views:PinDot Signal="SCL" />
                                <views:PinDot Signal="GND" Gray="True" Hollow="True" />
                                <views:PinDot Signal="3V3" Gray="True" />
                                <views:PinDot Signal="5V" Gray="True" />
                            </StackPanel>
                        </StackPanel>
                        </Border>
                        <Border Grid.Column="1" Margin="6,0,0,0" Padding="10" CornerRadius="6"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="通道 1" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <views:PinDot Signal="SDA" />
                                <views:PinDot Signal="SCL" />
                                <views:PinDot Signal="GND" Gray="True" Hollow="True" />
                                <views:PinDot Signal="3V3" Gray="True" />
                                <views:PinDot Signal="5V" Gray="True" />
                            </StackPanel>
                        </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </ui:Card>

        </StackPanel>
    </ScrollViewer>
</UserControl>

<UserControl x:Class="GinkgoHost.Views.DevicePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:GinkgoHost.Views">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="4,4,4,12">

            <views:ConnectBar />

            <TextBlock Text="Device Info" FontSize="15" FontWeight="SemiBold" Margin="4,0,0,6" />
            <ui:Card Margin="0,0,0,14">
                <Grid Margin="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                    </Grid.RowDefinitions>
                    <TextBlock Text="适配器" Opacity="0.65" Margin="0,0,32,8" />
                    <TextBlock x:Name="TxtModel" Grid.Column="1" Text="Ginkgo VTG200A USB-I2C（检测后确认）" />
                    <TextBlock Text="驱动" Grid.Row="1" Opacity="0.65" Margin="0,0,32,8" />
                    <TextBlock x:Name="TxtDriver" Grid.Row="1" Grid.Column="1" Text="—" />
                    <TextBlock Text="适配器数" Grid.Row="2" Opacity="0.65" Margin="0,0,32,8" />
                    <TextBlock x:Name="TxtCount" Grid.Row="2" Grid.Column="1" Text="—" />
                    <TextBlock Text="状态" Grid.Row="3" Opacity="0.65" Margin="0,0,32,8" />
                    <TextBlock x:Name="TxtDevState" Grid.Row="3" Grid.Column="1" Text="未连接" />
                    <TextBlock Text="协议" Grid.Row="4" Opacity="0.65" Margin="0,0,32,0" />
                    <TextBlock Grid.Row="4" Grid.Column="1" Text="I2C 主机模式（硬件 / 软件 GPIO）+ SMBus/PMBus · 从机模式规划中" />
                </Grid>
            </ui:Card>

            <TextBlock Text="Connector · VTG200A 引脚" FontSize="15" FontWeight="SemiBold" Margin="4,0,0,6" />
            <ui:Card>
                <StackPanel Margin="8">
                    <TextBlock Text="驱动不提供实时引脚电平，以下为静态接线示意。" Opacity="0.5" Margin="0,0,0,12" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition /><ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="通道 0" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <views:PinDot Signal="SDA" />
                                <views:PinDot Signal="SCL" />
                                <views:PinDot Signal="GND" Gray="True" />
                                <views:PinDot Signal="3V3" Gray="True" />
                                <views:PinDot Signal="5V" Gray="True" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="通道 1" FontWeight="SemiBold" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <views:PinDot Signal="SDA" />
                                <views:PinDot Signal="SCL" />
                                <views:PinDot Signal="GND" Gray="True" />
                                <views:PinDot Signal="3V3" Gray="True" />
                                <views:PinDot Signal="5V" Gray="True" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </ui:Card>

        </StackPanel>
    </ScrollViewer>
</UserControl>

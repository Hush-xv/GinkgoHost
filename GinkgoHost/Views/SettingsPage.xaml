<UserControl x:Class="GinkgoHost.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="8,6,8,18" MaxWidth="720" HorizontalAlignment="Left">

            <TextBlock Text="设置" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="调整外观，并查看本机配置与应用信息" Style="{StaticResource PageSubtitleStyle}" />

            <TextBlock Text="外观" Style="{StaticResource SectionTitleStyle}" />
            <ui:Card Margin="0,0,0,14">
                <StackPanel Margin="4">
                    <TextBlock Text="主题" Opacity="0.75" />
                    <ComboBox x:Name="CmbTheme" MinWidth="160" Margin="0,4,0,0" SelectionChanged="CmbTheme_SelectionChanged">
                        <ComboBoxItem Content="Dark（默认）" />
                        <ComboBoxItem Content="Light" />
                    </ComboBox>
                </StackPanel>
            </ui:Card>

            <TextBlock Text="连接参数记忆" Style="{StaticResource SectionTitleStyle}" />
            <ui:Card Margin="0,0,0,14">
                <StackPanel Margin="4">
                    <TextBlock Text="通道、速率、上次从机地址会随操作自动保存，重启后恢复。"
                               Opacity="0.85" TextWrapping="Wrap" />
                    <TextBlock x:Name="TxtSettingsPath" Opacity="0.45" Margin="0,8,0,0"
                               FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>

            <TextBlock Text="关于" Style="{StaticResource SectionTitleStyle}" />
            <ui:Card>
                <StackPanel Margin="4">
                    <TextBlock Text="GinkgoHost · 复刻 Binho Mission Control 交互布局" Opacity="0.85" />
                    <TextBlock Text="协议引擎：ViewTool Ginkgo_Driver.dll · UI：WPF + WPF-UI (Fluent)"
                               Opacity="0.55" Margin="0,4,0,0" />
                </StackPanel>
            </ui:Card>

        </StackPanel>
    </ScrollViewer>
</UserControl>

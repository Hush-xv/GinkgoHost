<UserControl x:Class="GinkgoHost.Views.SlavePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <Style x:Key="SlaveRegTextStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="6,0" />
        </Style>
        <Style x:Key="SlaveRegEditStyle" TargetType="TextBox" />
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <!-- 与设置/设备页同款版式：左对齐内容列（固定宽度），卡片拉伸填充，不再居中悬浮 -->
        <StackPanel Margin="{StaticResource PageContentMargin}" Width="760" HorizontalAlignment="Left">

            <TextBlock Text="从机模拟" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Text="适配器作为 I²C 从机应答外部主机 · Ctrl+3" Style="{StaticResource PageSubtitleStyle}" />

            <TextBlock Text="从机配置" Style="{StaticResource SectionTitleStyle}" />
            <ui:Card Margin="0,0,0,20" Padding="16,14">
                <StackPanel>
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="从机地址" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ui:TextBox x:Name="TxtSlaveAddr" FontFamily="Consolas" Text="50" MinWidth="120"
                                        MaxLength="2" ToolTip="7 位地址，0x08–0x77" />
                            <TextBlock Text="通道" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="14,0,8,0" />
                            <ComboBox x:Name="CmbSlaveChannel" MinWidth="110" SelectedIndex="0" ToolTip="从机使用的硬件 I²C 通道，两通道均支持">
                                <ComboBoxItem Content="通道 0" />
                                <ComboBoxItem Content="通道 1" />
                            </ComboBox>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="硬件 I²C · 100 kHz"
                                   FontSize="11" Opacity="0.55" Margin="0,6,0,0" />
                    </Grid>
                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                        <ui:Button x:Name="BtnSlaveStart" Content="启动从机" Appearance="Primary" MinWidth="104" MinHeight="34"
                                   Click="BtnSlaveStart_Click" ToolTip="适配器进入从机模式并开始应答" />
                        <ui:Button x:Name="BtnSlaveStop" Content="停止" Appearance="Danger" MinWidth="88" MinHeight="34"
                                   Margin="8,0,0,0" IsEnabled="False" Click="BtnSlaveStop_Click" />
                    </StackPanel>
                    <TextBlock x:Name="TxtSlaveState" MinHeight="16" Margin="0,8,0,0" FontSize="11" Opacity="0.7"
                               Text="主机模式未连接时可用；启动后其他页面的连接会被拒绝" TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>

            <TextBlock Text="应答内容" Style="{StaticResource SectionTitleStyle}" />
            <ui:Card Margin="0,0,0,20" Padding="16,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="模式" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <ComboBox x:Name="CmbSlaveMode" MinWidth="170" SelectedIndex="0" SelectionChanged="CmbSlaveMode_SelectionChanged"
                                  ToolTip="预载数据：按顺序循环应答；寄存器映射：主机写指针后读对应寄存器">
                            <ComboBoxItem Content="预载数据（顺序返回）" />
                            <ComboBoxItem Content="寄存器映射" />
                        </ComboBox>
                    </StackPanel>

                    <!-- 模式 A：预载数据 -->
                    <StackPanel x:Name="PnlPreload">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:TextBox x:Name="TxtRespData" FontFamily="Consolas" PlaceholderText="HEX，空格分隔，例如 DE AD BE EF"
                                        VerticalContentAlignment="Center" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                                <ui:Button x:Name="BtnLoadResp" Content="装载到从机" Appearance="Primary" MinWidth="104" MinHeight="34"
                                           Click="BtnLoadResp_Click" ToolTip="把应答数据追加到从机发送队列" />
                                <ui:Button x:Name="BtnRespZero" Content="清零" MinWidth="72" MinHeight="34" Margin="8,0,0,0"
                                           Click="BtnRespZero_Click" ToolTip="清空输入并装载单个 0x00" />
                            </StackPanel>
                        </Grid>
                        <TextBlock x:Name="TxtRespState" MinHeight="16" Margin="0,8,0,0" FontSize="11" Opacity="0.7"
                                   Text="主机读多少字节，就从队列头部顺序返回；装载是【追加】，排空后再装载下一段" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- 模式 B：寄存器映射 -->
                    <StackPanel x:Name="PnlRegister" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="指针宽度" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="CmbPtrWidth" MinWidth="110" SelectedIndex="0"
                                      ToolTip="主机写指针的字节数（大端）">
                                <ComboBoxItem Content="8-bit" />
                                <ComboBoxItem Content="16-bit" />
                            </ComboBox>
                            <ui:Button Content="添加行" FontSize="11" Padding="8,1" MinHeight="30" Margin="14,0,0,0" Click="BtnRegAdd_Click" />
                            <ui:Button Content="删除选中" FontSize="11" Padding="8,1" MinHeight="30" Margin="6,0,0,0" Click="BtnRegDel_Click" />
                            <ui:Button Content="清空表格" FontSize="11" Padding="8,1" MinHeight="30" Margin="6,0,0,0" Click="BtnRegClear_Click" />
                        </StackPanel>
                        <DataGrid x:Name="GridSlaveReg" AutoGenerateColumns="False" CanUserAddRows="False" CanUserSortColumns="False"
                                  HeadersVisibility="Column" FontFamily="Consolas" FontSize="12" RowHeight="32" ColumnHeaderHeight="28"
                                  MinHeight="96" MaxHeight="220" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="寄存器" Binding="{Binding Reg}" Width="90"
                                                    ElementStyle="{StaticResource SlaveRegTextStyle}" EditingElementStyle="{StaticResource SlaveRegEditStyle}" />
                                <DataGridTextColumn Header="值/HEX" Binding="{Binding Value}" Width="*"
                                                    ElementStyle="{StaticResource SlaveRegTextStyle}" EditingElementStyle="{StaticResource SlaveRegEditStyle}" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Text="主机写指针（1/2 字节，大端）后 ≥1 个轮询周期（20 ms）再读；读按寄存器自动递增，未编辑的寄存器返回 0x00；写数据会更新寄存器表"
                                   FontSize="11" Opacity="0.55" Margin="0,8,0,0" TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock x:Name="TxtModeState" MinHeight="16" Margin="0,8,0,0" FontSize="11" Opacity="0.7"
                               Text="启动从机时按所选模式生效；运行中修改后再次装载即可更新" TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>

            <TextBlock Text="主机写入监测" Style="{StaticResource SectionTitleStyle}" />
            <ui:Card Padding="16,14">
                <StackPanel>
                    <DockPanel Margin="0,0,0,8">
                        <ui:Button DockPanel.Dock="Right" Content="清空记录" FontSize="11" Padding="8,1" MinHeight="30"
                                   Click="BtnClearRx_Click" />
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="收到写入" FontSize="12" Opacity="0.75" VerticalAlignment="Center" />
                            <TextBlock x:Name="TxtRxCount" Text=" · 0 次" FontSize="12" Opacity="0.75" VerticalAlignment="Center" Margin="4,0,0,0" />
                        </StackPanel>
                    </DockPanel>
                    <Border Padding="8" CornerRadius="8" Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                        <ListBox x:Name="LstSlaveRx" FontFamily="Consolas" FontSize="13" MinHeight="180" MaxHeight="360"
                                 Background="Transparent" BorderThickness="0" Padding="4"
                                 VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,1" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>
                    </Border>
                    <TextBlock Text="外部主机写入的数据会显示在这里；寄存器模式下同时显示指针跳转与寄存器更新"
                               FontSize="11" Opacity="0.55" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </ui:Card>

        </StackPanel>
    </ScrollViewer>
</UserControl>

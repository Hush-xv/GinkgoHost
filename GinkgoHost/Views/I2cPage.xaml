<UserControl x:Class="GinkgoHost.Views.I2cPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:GinkgoHost.Views">
    <UserControl.Resources>
        <!-- 行状态文字：OK 绿 / ERR 红 -->
        <Style x:Key="RowStatusStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#81C784" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="ERR">
                    <Setter Property="Foreground" Value="#EF5350" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <views:ConnectBar DockPanel.Dock="Top" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="380" MinWidth="300" MaxWidth="700" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- ═══ 左列：主控 / 扩展 标签 + 内容 ═══ -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>
                <StackPanel Orientation="Horizontal" Margin="4,4,0,6">
                    <ui:Button x:Name="BtnTabMain" Content="主控面板" Appearance="Primary"
                               Click="BtnTabMain_Click" MinWidth="96" Margin="0,0,6,0" />
                    <ui:Button x:Name="BtnTabExt" Content="🧩 扩展"
                               Click="BtnTabExt_Click" MinWidth="96" />
                </StackPanel>

                <!-- ── 主控面板 ── -->
                <ScrollViewer x:Name="MainScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,0,4,12">

                        <TextBlock Text="Settings" FontSize="15" FontWeight="SemiBold" Margin="4,0,0,6" />
                        <ui:Card Margin="0,0,0,10">
                            <Grid Margin="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Control Mode" Opacity="0.75" />
                                    <ComboBox x:Name="CmbCtrlMode" MinWidth="150" Margin="0,4,0,10"
                                              SelectionChanged="CmbCtrlMode_SelectionChanged">
                                        <ComboBoxItem Content="Hardware I2C" Tag="1" />
                                        <ComboBoxItem Content="Software I2C (GPIO)" Tag="2" />
                                    </ComboBox>
                                    <TextBlock Text="Clock Frequency" Opacity="0.75" />
                                    <ComboBox x:Name="CmbSpeed" MinWidth="150" Margin="0,4,0,10" SelectionChanged="CmbSpeed_SelectionChanged">
                                        <ComboBoxItem Content="100 kHz" Tag="100000" />
                                        <ComboBoxItem Content="400 kHz" Tag="400000" />
                                        <ComboBoxItem Content="1 MHz" Tag="1000000" />
                                        <ComboBoxItem Content="1.2 MHz" Tag="1200000" />
                                    </ComboBox>
                                    <TextBlock Text="Channel" Opacity="0.75" />
                                    <ComboBox x:Name="CmbChannel" MinWidth="150" Margin="0,4,0,0" SelectionChanged="CmbChannel_SelectionChanged" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <ui:ToggleSwitch x:Name="TglNonStd" Content="Non-Standard Frequencies"
                                                     Checked="TglNonStd_Changed" Unchecked="TglNonStd_Changed" />
                                    <TextBlock Text="自定义频率 (Hz)" Opacity="0.75" Margin="0,10,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                        <ui:TextBox x:Name="TxtCustomHz" Text="200000" MinWidth="130" IsEnabled="False" />
                                        <ui:Button x:Name="BtnApplyHz" Content="应用" IsEnabled="False"
                                                   Click="BtnApplyHz_Click" Margin="8,0,0,0" />
                                    </StackPanel>
                                    <TextBlock FontSize="11" Opacity="0.45" Margin="0,16,0,0" TextWrapping="Wrap"
                                               Text="Internal Pull-Up Resistors：板载跳线控制（无软件接口）&#x0a;Bus Voltage：固定 3.3 V" />
                                </StackPanel>
                            </Grid>
                        </ui:Card>

                        <TextBlock Text="Target Device" FontSize="15" FontWeight="SemiBold" Margin="4,0,0,6" />
                        <ui:Card Margin="0,0,0,10">
                            <StackPanel Margin="4">
                                <DockPanel LastChildFill="False">
                                    <TextBlock Text="Address" Opacity="0.75" VerticalAlignment="Center" />
                                    <ui:Button x:Name="BtnScanBus" Content="SCAN" Click="BtnScan_Click"
                                               DockPanel.Dock="Right" HorizontalAlignment="Right"
                                               MinWidth="88" Margin="8,0,0,0" />
                                </DockPanel>
                                <ui:TextBox x:Name="TxtAddr" Margin="0,6,0,0" FontFamily="Consolas" FontSize="14"
                                            GotFocus="TxtAddr_GotFocus" TextChanged="TxtAddr_TextChanged" />
                                <TextBlock x:Name="TxtScanResult" Text="—" Opacity="0.85" Margin="0,8,0,0"
                                           TextWrapping="Wrap" />
                                <WrapPanel x:Name="ChipPanel" Margin="0,4,0,0" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Address Format" Opacity="0.75" />
                                        <ComboBox x:Name="CmbAddrFmt" SelectedIndex="0" Margin="0,4,0,0"
                                                  SelectionChanged="CmbAddrFmt_SelectionChanged">
                                            <ComboBoxItem Content="7-bit" />
                                            <ComboBoxItem Content="8-bit" />
                                        </ComboBox>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Subaddress: 0x" Opacity="0.75"
                                                   ToolTip="寄存器号（子地址）。留空 = 原始读写" />
                                        <ui:TextBox x:Name="TxtSubAddr" Text="00" MaxLength="4" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </ui:Card>

                        <TextBlock Text="Transactions" FontSize="15" FontWeight="SemiBold" Margin="4,0,0,6" />
                        <ui:Card Margin="0,0,0,10">
                            <Grid Margin="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Write Buffer" Opacity="0.75" />
                                    <ui:TextBox x:Name="TxtWriteBuf" Text="DE AD BE EF" Margin="0,4,0,8" />
                                    <ui:Button x:Name="BtnWrite" Content="WRITE" Appearance="Primary" Click="BtnWrite_Click" />
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Read Size" Opacity="0.75" />
                                    <ui:TextBox x:Name="TxtReadSize" Text="8" Margin="0,4,0,8" />
                                    <ui:Button x:Name="BtnRead" Content="READ" Click="BtnRead_Click" />
                                    <TextBlock x:Name="TxtReadResult" Text=" " Margin="0,8,0,0" FontFamily="Consolas"
                                               TextWrapping="Wrap" Foreground="#9a86fd" />
                                </StackPanel>
                            </Grid>
                        </ui:Card>

                        <TextBlock Text="⏱️ 周期任务" FontSize="15" FontWeight="SemiBold" Margin="4,0,0,6" />
                        <ui:Card>
                            <Grid Margin="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <TextBlock Text="周期读（用上方 READ 参数）" FontWeight="SemiBold" />
                                        <ui:Button x:Name="BtnPeriodR" Content="开始" Click="BtnPeriodR_Click"
                                                   DockPanel.Dock="Right" HorizontalAlignment="Right" MinWidth="76"
                                                   Appearance="Primary" />
                                    </DockPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <ui:TextBox x:Name="TxtPeriodR" Text="500" Width="90" />
                                        <TextBlock Text="ms（最低 10）" VerticalAlignment="Center" Margin="6,0,12,0" Opacity="0.6" />
                                        <TextBlock x:Name="TxtLastR" Text="—" FontFamily="Consolas" VerticalAlignment="Center"
                                                   Foreground="#C4B9FE" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <DockPanel LastChildFill="False">
                                        <TextBlock Text="周期写（用上方 WRITE 参数）" FontWeight="SemiBold" />
                                        <ui:Button x:Name="BtnPeriodW" Content="开始" Click="BtnPeriodW_Click"
                                                   DockPanel.Dock="Right" HorizontalAlignment="Right" MinWidth="76" />
                                    </DockPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <ui:TextBox x:Name="TxtPeriodW" Text="1000" Width="90" />
                                        <TextBlock Text="ms（最低 10）" VerticalAlignment="Center" Margin="6,0,12,0" Opacity="0.6" />
                                        <TextBlock x:Name="TxtCountW" Text="—" FontFamily="Consolas" VerticalAlignment="Center" Opacity="0.85" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </ui:Card>

                    </StackPanel>
                </ScrollViewer>

                <!-- ── 扩展面板 ── -->
                <Grid x:Name="ExtPanel" Grid.Row="1" Visibility="Collapsed" Margin="4,0,4,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <ui:Card Margin="0,0,0,10">
                        <StackPanel Orientation="Horizontal" Margin="4">
                            <TextBlock Text="从机地址" VerticalAlignment="Center" Opacity="0.75"
                                       ToolTip="7 位地址（hex），如 8 位标注的 0x92 请填 49" />
                            <ui:TextBox x:Name="TxtSlave" Text="49" Width="64" MaxLength="4" Margin="8,0,16,0" />
                            <TextBlock Text="寄存器地址宽度" VerticalAlignment="Center" Opacity="0.75" />
                            <ComboBox x:Name="CmbRegWidth" SelectedIndex="0" MinWidth="100" Margin="8,0,16,0">
                                <ComboBoxItem Content="Reg 8Bit" Tag="1" />
                                <ComboBoxItem Content="Reg 16Bit" Tag="2" />
                            </ComboBox>
                        </StackPanel>
                    </ui:Card>

                    <DockPanel Grid.Row="1" Margin="4,0,0,6" LastChildFill="False">
                        <StackPanel Orientation="Horizontal">
                            <ui:Button x:Name="BtnSubReg" Content="寄存器表" Appearance="Primary"
                                       Click="BtnSubReg_Click" MinWidth="96" Margin="0,0,6,0" />
                            <ui:Button x:Name="BtnSubInit" Content="初始化序列"
                                       Click="BtnSubInit_Click" MinWidth="96" Margin="0,0,6,0" />
                            <ui:Button x:Name="BtnSubPeriod" Content="周期触发"
                                       Click="BtnSubPeriod_Click" MinWidth="96" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                            <TextBlock Text="Profile" VerticalAlignment="Center" Opacity="0.75" />
                            <ComboBox x:Name="CmbProfile" MinWidth="120" Margin="8,0,0,0" />
                            <ui:Button x:Name="BtnSave" Content="保存" Click="BtnSave_Click" Margin="8,0,0,0" />
                            <ui:Button x:Name="BtnLoad" Content="载入" Click="BtnLoad_Click" Margin="8,0,0,0" />
                            <ui:Button x:Name="BtnDelete" Content="删除" Click="BtnDelete_Click" Margin="8,0,0,0" />
                        </StackPanel>
                    </DockPanel>

                    <Grid Grid.Row="2">
                        <!-- 寄存器表 -->
                        <Grid x:Name="RegHost">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,6" LastChildFill="False">
                                <ui:Button x:Name="BtnAddRow" Content="添加行" Click="BtnAddRow_Click" />
                                <ui:Button x:Name="BtnDelRow" Content="删除选中" Click="BtnDelRow_Click" Margin="8,0,12,0" />
                                <ui:Button x:Name="BtnReadAll" Content="一键读取全部" Appearance="Primary"
                                           Click="BtnReadAll_Click" MinWidth="110" DockPanel.Dock="Right" />
                            </DockPanel>
                            <DataGrid x:Name="GridReg" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                                      HeadersVisibility="Column" MinHeight="200"
                                      RowBackground="Transparent" AlternatingRowBackground="#0AFFFFFF"
                                      FontFamily="Consolas" FontSize="12"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Reg地址" Binding="{Binding Reg}" Width="76" />
                                    <DataGridTextColumn Header="长度" Binding="{Binding Len}" Width="50" />
                                    <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="120" />
                                    <DataGridTemplateColumn Header="读写" Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                            <ComboBox SelectedIndex="{Binding Dir, Converter={StaticResource DirIndex}, Mode=TwoWay}" FontSize="12">
                                                <ComboBoxItem Content="R" />
                                                <ComboBoxItem Content="W" />
                                            </ComboBox>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="60"
                                                        ElementStyle="{StaticResource RowStatusStyle}" IsReadOnly="True" />
                                    <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="110" />
                                <DataGridTemplateColumn Header="执行" Width="70">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="执行" Click="BtnRowExec_Click" Width="56" Padding="2" Margin="2" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <!-- 初始化序列 -->
                        <Grid x:Name="InitHost" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,6" LastChildFill="False">
                                <ui:Button x:Name="BtnAddInit" Content="添加行" Click="BtnAddInit_Click" />
                                <ui:Button x:Name="BtnDelInit" Content="删除选中" Click="BtnDelInit_Click" Margin="8,0,12,0" />
                                <ui:Button x:Name="BtnRunInit" Content="一键初始化" Appearance="Primary"
                                           Click="BtnRunInit_Click" MinWidth="110" DockPanel.Dock="Right" />
                            </DockPanel>
                            <DataGrid x:Name="GridInit" Grid.Row="1" AutoGenerateColumns="False" CanUserAddRows="False"
                                      HeadersVisibility="Column" MinHeight="200"
                                      RowBackground="Transparent" AlternatingRowBackground="#0AFFFFFF"
                                      FontFamily="Consolas" FontSize="12">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="延时ms" Binding="{Binding DelayMs}" Width="70" />
                                    <DataGridTextColumn Header="Reg地址" Binding="{Binding Reg}" Width="90" />
                                    <DataGridTextColumn Header="写入数据" Binding="{Binding Value}" Width="*" />
                                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="70"
                                                        ElementStyle="{StaticResource RowStatusStyle}" IsReadOnly="True" />
                                    <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="130" />
                                    <DataGridTemplateColumn Header="执行" Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="写" Click="BtnInitRowWrite_Click" Width="40" Padding="2" Margin="2" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <!-- 周期触发 -->
                        <ui:Card x:Name="PeriodHost" Visibility="Collapsed">
                            <StackPanel Margin="4">
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox x:Name="ChkInitFirst" Content="每周期先执行初始化" VerticalAlignment="Center" />
                                    <TextBlock Text="间隔" VerticalAlignment="Center" Margin="24,0,6,0" Opacity="0.75" />
                                    <ui:TextBox x:Name="TxtExtPeriodMs" Text="1000" Width="90" />
                                    <TextBlock Text="ms（最低 10）" VerticalAlignment="Center" Margin="6,0,0,0" Opacity="0.6" />
                                    <ui:Button x:Name="BtnExtPeriod" Content="开始" Appearance="Primary" MinWidth="88"
                                               Click="BtnExtPeriod_Click" Margin="18,0,0,0" />
                                </StackPanel>
                                <TextBlock x:Name="TxtExtPeriodState" Text="—" Margin="0,10,0,0"
                                           FontFamily="Consolas" Opacity="0.85" TextWrapping="Wrap" />
                            </StackPanel>
                        </ui:Card>
                    </Grid>
                </Grid>
            </Grid>

            <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                          MouseDoubleClick="Splitter_DoubleClick" ToolTip="拖拽调整 · 双击复位" />

            <views:LogPanel x:Name="LogView" Grid.Column="2" MinWidth="300" Margin="0,4,4,12" />
        </Grid>
    </DockPanel>
</UserControl>

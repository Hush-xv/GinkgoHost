<UserControl x:Class="GinkgoHost.Views.I2cPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:GinkgoHost.Views"
             Focusable="True" PreviewKeyDown="I2cPage_PreviewKeyDown">
    <UserControl.Resources>
        <!-- 行状态文字：OK 绿 / ERR 红 -->
        <Style x:Key="RowStatusStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#81C784" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="ERR">
                    <Setter Property="Foreground" Value="#EF5350" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 扩展表格保持整行选中提示，避免单元格默认色遮挡当前操作行。 -->
        <Style x:Key="ExtDataGridRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#12FFFFFF" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#443B2F7A" />
                    <Setter Property="BorderBrush" Value="#9A86FD" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <DataTrigger Binding="{Binding Status}" Value="OK">
                    <Setter Property="Background" Value="#133C8049" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="ERR">
                    <Setter Property="Background" Value="#1A9A3E46" />
                    <Setter Property="BorderBrush" Value="#704E2A2E" />
                    <Setter Property="BorderThickness" Value="2,0,0,0" />
                </DataTrigger>
                <!-- 周期轮询运行中：品牌紫左边条压过 OK/ERR 底色，表示这一行正在活 -->
                <DataTrigger Binding="{Binding Polling}" Value="True">
                    <Setter Property="Background" Value="#209A86FD" />
                    <Setter Property="BorderBrush" Value="#9A86FD" />
                    <Setter Property="BorderThickness" Value="3,0,0,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ExtDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- DataGrid 默认编辑框会回退到系统浅色主题；统一为深色行内编辑器。 -->
        <Style x:Key="ExtEditTextStyle" TargetType="TextBox">
            <Setter Property="Background" Value="#242424" />
            <Setter Property="Foreground" Value="#F4F4F4" />
            <Setter Property="CaretBrush" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#5A5A5A" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SelectionBrush" Value="#805C4BBA" />
            <Setter Property="SelectionOpacity" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#A997FF" />
                    <Setter Property="Background" Value="#2B2738" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ExtNumberEditTextStyle" TargetType="TextBox" BasedOn="{StaticResource ExtEditTextStyle}">
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <Style x:Key="ExtHexTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="5,0" />
        </Style>
        <Style x:Key="ExtNumberTextStyle" TargetType="TextBlock" BasedOn="{StaticResource ExtHexTextStyle}">
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <Style x:Key="ExtDataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#383838" />
            <Setter Property="Foreground" Value="#D4D4D4" />
            <Setter Property="BorderBrush" Value="#4B4B4B" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <!-- 数据操作区采用固定的分组表面；窗口缩放仅改变分组位置，不改变控件外观。 -->
        <Style x:Key="DataGroupStyle" TargetType="Border">
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="#303030" />
            <Setter Property="BorderBrush" Value="#4A4A4A" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="DataGroupHeadingStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#D4D4D4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- ═══ 总线设置条 ═══ -->
        <Border DockPanel.Dock="Top" Margin="8,0,8,6" CornerRadius="8" Padding="10,5"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Right" CornerRadius="6"
                        Background="{DynamicResource ControlFillColorDefaultBrush}" Padding="3" Margin="14,0,0,0">
                    <UniformGrid Rows="1">
                        <ui:Button x:Name="BtnTabMain" Content="基础操作" MinWidth="82"
                                   Click="BtnTabMain_Click" CornerRadius="4,0,0,4" />
                        <ui:Button x:Name="BtnTabExt" Content="寄存器工具" MinWidth="82"
                                   Click="BtnTabExt_Click" CornerRadius="0,4,4,0" />
                    </UniformGrid>
                </Border>
                <WrapPanel VerticalAlignment="Center">
                    <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
                        <TextBlock Text="I²C 工作台" FontWeight="SemiBold" />
                        <TextBlock Text="总线上下文" FontSize="10" Opacity="0.5" Margin="0,1,0,0" />
                    </StackPanel>
                    <ComboBox x:Name="CmbCtrlMode" MinWidth="120" Margin="0,0,10,0" SelectionChanged="CmbCtrlMode_SelectionChanged"
                              ToolTip="Ginkgo 工作模式：硬件 I²C 用片上外设，软件 I²C 由 GPIO 模拟（速率较低）">
                        <ComboBoxItem Content="硬件 I²C" Tag="1" />
                        <ComboBoxItem Content="软件 I²C (GPIO)" Tag="2" />
                    </ComboBox>
                    <ComboBox x:Name="CmbChannel" MinWidth="92" Margin="0,0,10,0" SelectionChanged="CmbChannel_SelectionChanged"
                              ToolTip="通道" />
                    <ComboBox x:Name="CmbSpeed" MinWidth="110" Margin="0,0,14,0" SelectionChanged="CmbSpeed_SelectionChanged"
                              ToolTip="速率">
                        <ComboBoxItem Content="100 kHz" Tag="100000" />
                        <ComboBoxItem Content="400 kHz" Tag="400000" />
                        <ComboBoxItem Content="1 MHz" Tag="1000000" />
                        <ComboBoxItem Content="1.2 MHz" Tag="1200000" />
                    </ComboBox>
                    <ui:ToggleSwitch x:Name="TglNonStd" Content="自定义频率" VerticalAlignment="Center"
                                     Checked="TglNonStd_Changed" Unchecked="TglNonStd_Changed" />
                    <Grid Margin="10,0,0,0">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=TglNonStd}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="TxtCustomHz" Text="200000" IsEnabled="False" />
                        <ui:Button x:Name="BtnApplyHz" Grid.Column="1" Content="应用" IsEnabled="False"
                                   Click="BtnApplyHz_Click" Margin="6,0,0,0" />
                    </Grid>
                </WrapPanel>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ControlColumn" Width="0" MinWidth="0" MaxWidth="560" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- ── 扩展面板 ── -->
            <Grid x:Name="ExtPanel" Grid.Column="0" Visibility="Collapsed" Margin="0,0,4,12"
                  VerticalAlignment="Top">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <ui:Card Margin="0,0,0,10">
                        <WrapPanel Margin="4">
                            <TextBlock x:Name="TxtExtSlaveLabel" Text="从机地址 · 7-bit" VerticalAlignment="Center" Opacity="0.75" />
                            <ui:TextBox x:Name="TxtSlave" Text="49" Width="64" MaxLength="2" Margin="8,0,16,0"
                                        TextChanged="TxtSlave_TextChanged" />
                            <TextBlock Text="寄存器地址宽度" VerticalAlignment="Center" Opacity="0.75" />
                            <ComboBox x:Name="CmbRegWidth" SelectedIndex="0" MinWidth="100" Margin="8,0,16,0">
                                <ComboBoxItem Content="Reg 8Bit" Tag="1" />
                                <ComboBoxItem Content="Reg 16Bit" Tag="2" />
                            </ComboBox>
                        </WrapPanel>
                    </ui:Card>

                    <StackPanel Grid.Row="1" Margin="4,0,0,8">
                    <WrapPanel>
                        <ui:Button x:Name="BtnSubReg" Content="寄存器表" Appearance="Primary"
                                   Click="BtnSubReg_Click" MinWidth="96" Margin="0,0,6,6" />
                        <ui:Button x:Name="BtnSubInit" Content="初始化序列"
                                   Click="BtnSubInit_Click" MinWidth="96" Margin="0,0,18,6" />
                        <TextBlock Text="Profile" VerticalAlignment="Center" Opacity="0.75" Margin="0,0,8,6" />
                        <ComboBox x:Name="CmbProfile" MinWidth="120" Margin="0,0,8,6" />
                        <ui:Button x:Name="BtnSave" Content="保存" Click="BtnSave_Click" MinWidth="64" Margin="0,0,6,6" />
                        <ui:Button x:Name="BtnLoad" Content="载入" Click="BtnLoad_Click" MinWidth="64" Margin="0,0,6,6" />
                        <ui:Button x:Name="BtnDelete" Content="删除" Click="BtnDelete_Click" MinWidth="64" Margin="0,0,0,6" />
                    </WrapPanel>
                    <Border Padding="8,4" CornerRadius="5" Background="#303030" BorderBrush="#484848" BorderThickness="1">
                        <TextBlock x:Name="TxtExtStatus" FontSize="12" Foreground="#C8C8C8" />
                    </Border>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <!-- 寄存器表 -->
                        <Grid x:Name="RegHost">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,6" LastChildFill="False">
                                <TextBlock Text="寄存器列表" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <ui:Button x:Name="BtnAddRow" Content="添加行" Click="BtnAddRow_Click" />
                                <ui:Button x:Name="BtnDelRow" Content="删除选中" Click="BtnDelRow_Click"
                                           IsEnabled="False" Margin="8,0,12,0" />
                                <ui:Button x:Name="BtnReadAll" Content="一键读取全部" Appearance="Primary"
                                           Click="BtnReadAll_Click" MinWidth="110" DockPanel.Dock="Right" />
                                <ui:Button x:Name="BtnStopPolling" Content="停止轮询" Appearance="Danger"
                                           Click="BtnStopPolling_Click" MinWidth="92" Margin="0,0,8,0"
                                           DockPanel.Dock="Right" Visibility="Collapsed" />
                            </DockPanel>
                            <Grid Grid.Row="1">
                            <DataGrid x:Name="GridReg" AutoGenerateColumns="False" CanUserAddRows="False"
                                      HeadersVisibility="Column" MinHeight="200"
                                      SelectionChanged="GridReg_SelectionChanged"
                                      PreparingCellForEdit="Grid_PreparingCellForEdit"
                                      SelectionUnit="FullRow" RowStyle="{StaticResource ExtDataGridRowStyle}"
                                      CellStyle="{StaticResource ExtDataGridCellStyle}"
                                      RowBackground="Transparent" AlternatingRowBackground="#0AFFFFFF"
                                      Background="#252525" BorderBrush="#484848" BorderThickness="1"
                                      ColumnHeaderStyle="{StaticResource ExtDataGridHeaderStyle}"
                                      FontFamily="Consolas" FontSize="12" RowHeight="32" ColumnHeaderHeight="28" MaxHeight="520"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                <DataGridTextColumn Header="Reg" Binding="{Binding Reg}" Width="64"
                                                    ElementStyle="{StaticResource ExtHexTextStyle}" EditingElementStyle="{StaticResource ExtEditTextStyle}" />
                                <DataGridTextColumn Header="长度" Binding="{Binding Len}" Width="50"
                                                    ElementStyle="{StaticResource ExtNumberTextStyle}" EditingElementStyle="{StaticResource ExtNumberEditTextStyle}" />
                                <DataGridTextColumn Header="周期" Binding="{Binding PeriodMs}" Width="62"
                                                    ElementStyle="{StaticResource ExtNumberTextStyle}" EditingElementStyle="{StaticResource ExtNumberEditTextStyle}" />
                                <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="*" MinWidth="108"
                                                    ElementStyle="{StaticResource ExtHexTextStyle}" EditingElementStyle="{StaticResource ExtEditTextStyle}" />
                                    <DataGridTemplateColumn Header="读写" Width="56">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                            <ComboBox SelectedIndex="{Binding Dir, Converter={StaticResource DirIndex}, Mode=TwoWay}" FontSize="12">
                                                <ComboBoxItem Content="R" />
                                                <ComboBoxItem Content="W" />
                                            </ComboBox>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="50"
                                                        ElementStyle="{StaticResource RowStatusStyle}" IsReadOnly="True" />
                                <DataGridTemplateColumn Header="执行" Width="66">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="执行" Click="BtnRowExec_Click" Width="62" Padding="2" Margin="2"
                                                    IsEnabled="{Binding CanExecuteExtended, RelativeSource={RelativeSource AncestorType={x:Type views:I2cPage}}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="TxtRegEmpty" Text="尚无寄存器项 · 点击“添加行”开始配置"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#B8B8B8"
                                       IsHitTestVisible="False" Visibility="Collapsed" />
                            </Grid>
                        </Grid>

                        <!-- 初始化序列 -->
                        <Grid x:Name="InitHost" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,6" LastChildFill="False">
                                <TextBlock Text="初始化步骤" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <ui:Button x:Name="BtnAddInit" Content="添加行" Click="BtnAddInit_Click" />
                                <ui:Button x:Name="BtnDelInit" Content="删除选中" Click="BtnDelInit_Click"
                                           IsEnabled="False" Margin="8,0,12,0" />
                                <ui:Button x:Name="BtnRunInit" Content="一键初始化" Appearance="Primary"
                                           Click="BtnRunInit_Click" MinWidth="110" DockPanel.Dock="Right" />
                            </DockPanel>
                            <Grid Grid.Row="1">
                            <DataGrid x:Name="GridInit" AutoGenerateColumns="False" CanUserAddRows="False"
                                      HeadersVisibility="Column" MinHeight="200"
                                      SelectionChanged="GridInit_SelectionChanged"
                                      PreparingCellForEdit="Grid_PreparingCellForEdit"
                                      SelectionUnit="FullRow" RowStyle="{StaticResource ExtDataGridRowStyle}"
                                      CellStyle="{StaticResource ExtDataGridCellStyle}"
                                      RowBackground="Transparent" AlternatingRowBackground="#0AFFFFFF"
                                      Background="#252525" BorderBrush="#484848" BorderThickness="1"
                                      ColumnHeaderStyle="{StaticResource ExtDataGridHeaderStyle}"
                                      FontFamily="Consolas" FontSize="12" RowHeight="32" ColumnHeaderHeight="28" MaxHeight="520">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="延时" Binding="{Binding DelayMs}" Width="62"
                                                    ElementStyle="{StaticResource ExtNumberTextStyle}" EditingElementStyle="{StaticResource ExtNumberEditTextStyle}" />
                                <DataGridTextColumn Header="Reg" Binding="{Binding Reg}" Width="64"
                                                    ElementStyle="{StaticResource ExtHexTextStyle}" EditingElementStyle="{StaticResource ExtEditTextStyle}" />
                                <DataGridTextColumn Header="长度" Binding="{Binding Len}" Width="50"
                                                    ElementStyle="{StaticResource ExtNumberTextStyle}" EditingElementStyle="{StaticResource ExtNumberEditTextStyle}" />
                                <DataGridTextColumn Header="数据" Binding="{Binding Value}" Width="*" MinWidth="108"
                                                    ElementStyle="{StaticResource ExtHexTextStyle}" EditingElementStyle="{StaticResource ExtEditTextStyle}" />
                                <DataGridTemplateColumn Header="读写" Width="56">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox SelectedIndex="{Binding Dir, Converter={StaticResource DirIndex}, Mode=TwoWay}" FontSize="12">
                                                <ComboBoxItem Content="R" />
                                                <ComboBoxItem Content="W" />
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="50"
                                                    ElementStyle="{StaticResource RowStatusStyle}" IsReadOnly="True" />
                                <DataGridTemplateColumn Header="执行" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="执行" Click="BtnInitRowExec_Click" Width="56" Padding="2" Margin="2"
                                                    IsEnabled="{Binding CanExecuteExtended, RelativeSource={RelativeSource AncestorType={x:Type views:I2cPage}}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="TxtInitEmpty" Text="尚无初始化步骤 · 添加行后可保存为 Profile"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#B8B8B8"
                                       IsHitTestVisible="False" Visibility="Collapsed" />
                            </Grid>
                        </Grid>

                    </Grid>
            </Grid>

            <GridSplitter x:Name="PanelSplitter" Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Visibility="Collapsed"
                          Style="{StaticResource WorkspaceSplitterStyle}"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                          Cursor="SizeWE" ShowsPreview="True"
                          DragCompleted="PanelSplitter_DragCompleted"
                          MouseDoubleClick="Splitter_DoubleClick" ToolTip="拖拽调整 · 双击复位" />

            <Grid Grid.Column="2" MinWidth="300" Margin="0,2,4,10">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="LogRow" Height="13*" MinHeight="180" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="DataRow" Height="7*" MinHeight="190" />
                </Grid.RowDefinitions>
                <views:LogPanel x:Name="LogView" />

                <GridSplitter x:Name="LogSplitter" Grid.Row="1" Height="8"
                              HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              Style="{StaticResource WorkspaceSplitterStyle}"
                              ResizeDirection="Rows" Cursor="SizeNS"
                              ResizeBehavior="PreviousAndNext" ShowsPreview="True"
                              DragCompleted="LogSplitter_DragCompleted"
                              MouseDoubleClick="LogSplitter_DoubleClick"
                              ToolTip="上下拖动调整区域 · 双击复位" />

                <!-- 数据操作：目标参数 | 命令编辑器 | 读取结果。Border 代替 ui:Card：其模板把内容垂直居中，拖大分隔条后内容会悬浮。 -->
                <Border x:Name="DataOperationsCard" Grid.Row="2" VerticalAlignment="Stretch"
                        Background="#252525" BorderBrush="#3D3D3D" BorderThickness="1" CornerRadius="8"
                        Margin="0,6,0,0" Padding="10,8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="86" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 固定单行命令栏；空间不足只横向滚动，避免缩放时重排控件。 -->
                        <ScrollViewer Grid.Row="0" Margin="0,0,0,6" HorizontalScrollBarVisibility="Auto"
                                      VerticalScrollBarVisibility="Disabled" CanContentScroll="False">
                            <StackPanel Orientation="Horizontal" MinWidth="1050" UseLayoutRounding="True" SnapsToDevicePixels="True">
                                <Border x:Name="DataTargetGroup" Style="{StaticResource DataGroupStyle}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="目标" Style="{StaticResource DataGroupHeadingStyle}" Margin="0,0,8,0" />
                                        <Grid Width="154" Margin="0,0,7,0">
                                            <ComboBox x:Name="CmbTarget" DisplayMemberPath="Display"
                                                      SelectionChanged="CmbTarget_SelectionChanged"
                                                      ToolTip="选择目标会同步从机地址和寄存器工具" />
                                            <TextBlock x:Name="TxtTargetEmpty" Text="选择已保存目标"
                                                       Margin="8,0,26,0" VerticalAlignment="Center"
                                                       Foreground="#A8A8A8" IsHitTestVisible="False" />
                                        </Grid>
                                        <ui:Button x:Name="BtnSaveTarget" Content="保存" Width="58" Margin="0,0,10,0"
                                                   Click="BtnSaveTarget_Click" ToolTip="将当前从机地址保存到目标列表" />
                                        <TextBlock Text="地址" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,5,0"
                                                   ToolTip="从机地址，HEX 格式" />
                                        <ui:TextBox x:Name="TxtAddr" Width="66" FontFamily="Consolas" Margin="0,0,8,0"
                                                    TextChanged="TxtAddr_TextChanged" LostFocus="TargetInput_LostFocus"
                                                    ToolTip="从机地址，HEX 格式（如 92 = 0x92）" />
                                        <ui:Button x:Name="BtnScanBus" Content="扫描" Click="BtnScan_Click" IsEnabled="False" Width="68" Margin="0,0,10,0"
                                                   ToolTip="扫描当前通道上的从机地址 (F5) · 扫描属于地址发现，与寄存器无关" />
                                        <TextBlock Text="格式" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <ComboBox x:Name="CmbAddrFmt" SelectedIndex="0" Width="88" Margin="0,0,8,0"
                                                  SelectionChanged="CmbAddrFmt_SelectionChanged"
                                                  ToolTip="从机地址显示格式：7-bit 为原始地址，8-bit 为读写合成地址（7-bit 左移 1 位）">
                                            <ComboBoxItem Content="7-bit" />
                                            <ComboBoxItem Content="8-bit" />
                                        </ComboBox>
                                        <TextBlock Text="寄存器" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,5,0"
                                                   ToolTip="寄存器号（子地址），HEX 格式。留空 = 原始读写" />
                                        <ui:TextBox x:Name="TxtSubAddr" Text="00" MaxLength="2" Width="72" FontFamily="Consolas" Margin="0,0,8,0"
                                                    TextChanged="TxtSubAddr_TextChanged" LostFocus="TargetInput_LostFocus"
                                                    ToolTip="寄存器地址，HEX 格式（00-FF）" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="DataTransferGroup" Style="{StaticResource DataGroupStyle}" Margin="10,0,0,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="读取参数" Style="{StaticResource DataGroupHeadingStyle}" Margin="0,0,8,0" />
                                        <TextBlock Text="长度" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                        <ui:TextBox x:Name="TxtReadSize" Text="8" Width="54" Margin="0,0,10,0"
                                                    TextChanged="TxtReadSize_TextChanged" LostFocus="DataInput_LostFocus" />
                                        <CheckBox x:Name="ChkWriteRead" Content="写后读取" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <Border Width="1" Height="22" Background="#3D3D3D" Margin="0,0,12,0" />
                                        <ui:Button x:Name="BtnRead" Content="读取" Click="BtnRead_Click" IsEnabled="False" Width="68" Margin="0,0,6,0"
                                                   ToolTip="读取数据 (Ctrl+R)" />
                                        <ui:Button x:Name="BtnWrite" Content="写入" IsEnabled="False" Click="BtnWrite_Click" Width="68"
                                                   ToolTip="写入数据 (Ctrl+W)" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <ui:TextBox x:Name="TxtDataBuffer" Grid.Row="1" Text="DE AD BE EF"
                                    FontFamily="Consolas" FontSize="14" AcceptsReturn="True" MinHeight="94"
                                    TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                    VerticalContentAlignment="Top" TextChanged="TxtDataBuffer_TextChanged"
                                    LostFocus="DataInput_LostFocus"
                                    Background="#303030" BorderBrush="#525252"
                                    PlaceholderText="输入待写数据；读取结果会显示在这里" />

                        <Border Grid.Row="2" Margin="0,6,0,0" Padding="6,4" CornerRadius="4"
                                Background="#303030" BorderBrush="#484848" BorderThickness="1">
                        <DockPanel>
                            <TextBlock x:Name="TxtBufferMeta" Text="4 字节 · 待写数据" DockPanel.Dock="Right"
                                       FontSize="11" Opacity="0.5" />
                            <TextBlock x:Name="TxtDataStatus" Text="输入数据后写入，或直接读取"
                                       FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>

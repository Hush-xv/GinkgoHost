<UserControl x:Class="GinkgoHost.Views.I2cPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:GinkgoHost.Views"
             Focusable="True" PreviewKeyDown="I2cPage_PreviewKeyDown">
    <UserControl.Resources>
        <!-- 行状态文字：OK 绿 / ERR 红 -->
        <Style x:Key="RowStatusStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Padding" Value="3,0" />
            <Setter Property="ToolTip" Value="{Binding StatusHint}" />
            <Setter Property="Foreground" Value="{DynamicResource StatusSuccessBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="ERR">
                    <Setter Property="Foreground" Value="{DynamicResource StatusErrorBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="INPUT">
                    <Setter Property="Foreground" Value="{DynamicResource StatusErrorBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 扩展表格保持整行选中提示，避免单元格默认色遮挡当前操作行。 -->
        <Style x:Key="ExtDataGridRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                </Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </Trigger>
                <DataTrigger Binding="{Binding Status}" Value="OK">
                    <Setter Property="Background" Value="#133C8049" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="ERR">
                    <Setter Property="Background" Value="#1A9A3E46" />
                    <Setter Property="BorderBrush" Value="#704E2A2E" />
                    <Setter Property="BorderThickness" Value="2,0,0,0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="INPUT">
                    <Setter Property="Background" Value="#18FFA726" />
                    <Setter Property="BorderBrush" Value="{DynamicResource StatusErrorBrush}" />
                    <Setter Property="BorderThickness" Value="2,0,0,0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding SnapshotChanged}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter Property="BorderThickness" Value="3,0,0,0" />
                </DataTrigger>
                <!-- 周期轮询运行中：品牌紫左边条压过 OK/ERR 底色，表示这一行正在活 -->
                <DataTrigger Binding="{Binding Polling}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter Property="BorderThickness" Value="3,0,0,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ExtDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- 行内编辑器跟随应用主题，避免浅色主题中出现固定深色编辑框。 -->
        <Style x:Key="ExtEditTextStyle" TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="5,1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="SelectionBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="SelectionOpacity" Value="1" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocused" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                    <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ExtNumberEditTextStyle" TargetType="TextBox" BasedOn="{StaticResource ExtEditTextStyle}">
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <Style x:Key="ExtHexTextStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="5,0" />
        </Style>
        <!-- 值/数据列：窄面板下超长 HEX 以省略号截断，不硬裁切；完整值仍在编辑与日志中 -->
        <Style x:Key="ExtHexTrimStyle" TargetType="TextBlock" BasedOn="{StaticResource ExtHexTextStyle}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding SnapshotHint}" />
        </Style>
        <Style x:Key="ExtNoteTrimStyle" TargetType="TextBlock" BasedOn="{StaticResource ExtHexTextStyle}">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Note}" />
        </Style>
        <Style x:Key="ExtNumberTextStyle" TargetType="TextBlock" BasedOn="{StaticResource ExtHexTextStyle}">
            <Setter Property="TextAlignment" Value="Right" />
        </Style>
        <!-- 紧凑参数列以同一中心线阅读；长 HEX 值列仍保留左对齐。 -->
        <Style x:Key="ExtCenteredTextStyle" TargetType="TextBlock" BasedOn="{StaticResource ExtHexTextStyle}">
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style x:Key="ExtCenteredNumberTextStyle" TargetType="TextBlock" BasedOn="{StaticResource ExtNumberTextStyle}">
            <Setter Property="TextAlignment" Value="Center" />
        </Style>
        <Style x:Key="ExtDataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
            <Setter Property="Padding" Value="7,5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <!-- 数据操作区采用固定的分组表面；窗口缩放仅改变分组位置，不改变控件外观。 -->
        <Style x:Key="DataGroupStyle" TargetType="Border">
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style x:Key="DataGroupHeadingStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- 命令参数统一为紧凑的等宽输入框，HEX 值在不同 DPI 下仍易于扫读。 -->
        <Style x:Key="CommandInputStyle" TargetType="ui:TextBox">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>

    <DockPanel>
            <!-- ═══ 总线设置条 ═══ -->
        <Border DockPanel.Dock="Top" Margin="12,0,12,8" CornerRadius="12" Padding="14,10"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                Effect="{StaticResource CardShadowSoft}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- 分段控件：外层药丸 + 内层平面切换，选中项浮起为主表面 -->
                <Border Grid.Column="2" VerticalAlignment="Center" CornerRadius="8"
                        Background="{DynamicResource ControlFillColorDefaultBrush}" Padding="3" Margin="14,0,0,0"
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                    <UniformGrid Rows="1">
                        <ui:Button x:Name="BtnTabMain" Content="基础事务" MinWidth="88" Margin="0,0,2,0" CornerRadius="6"
                                   Click="BtnTabMain_Click" BorderThickness="0" Background="Transparent" />
                        <ui:Button x:Name="BtnTabExt" Content="寄存器检查器" MinWidth="110" CornerRadius="6"
                                   Click="BtnTabExt_Click" BorderThickness="0" Background="Transparent" />
                    </UniformGrid>
                </Border>

                <!-- 宽屏信息轨：不再嵌套卡片，只保留当前工作上下文与最新证据。 -->
                <StackPanel x:Name="HeaderContextPanel" Grid.Column="1" Orientation="Horizontal"
                            Margin="28,0,18,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel x:Name="HeaderTargetGroup" Width="200" VerticalAlignment="Center">
                        <TextBlock Text="当前目标" FontSize="10" Opacity="0.52" />
                        <TextBlock x:Name="TxtHeaderTarget" Text="地址未设置" FontFamily="Consolas" FontSize="12"
                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Border x:Name="HeaderRecentDivider" Width="1" Height="28" Margin="22,0"
                            VerticalAlignment="Center" Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
                    <StackPanel x:Name="HeaderRecentGroup" Width="310" VerticalAlignment="Center">
                        <TextBlock Text="最近事务" FontSize="10" Opacity="0.52" />
                        <TextBlock x:Name="TxtHeaderRecent" Text="尚无事务记录" FontFamily="Consolas" FontSize="12"
                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>

                <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Margin="2,0,16,0" VerticalAlignment="Center">
                        <DockPanel LastChildFill="False">
                            <Border DockPanel.Dock="Right" Margin="10,0,0,0" Padding="7,2" CornerRadius="6"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="DotI2cConnection" Width="6" Height="6" Fill="{DynamicResource TextFillColorSecondaryBrush}"
                                             VerticalAlignment="Center" Margin="0,0,5,0" />
                                    <TextBlock x:Name="TxtI2cConnection" Text="未连接" FontSize="10" Opacity="0.78" />
                                </StackPanel>
                            </Border>
                            <TextBlock Text="I²C 工作台" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </DockPanel>
                        <TextBlock Text="总线配置 · Ctrl+2" FontSize="10" Opacity="0.5" Margin="0,2,0,0" />
                    </StackPanel>
                    <!-- 字段带标题：模式/通道/速率自释义，替代纯悬停提示 -->
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="模式" FontSize="10" Opacity="0.55" Margin="0,0,0,3" />
                        <ComboBox x:Name="CmbCtrlMode" MinWidth="122" SelectionChanged="CmbCtrlMode_SelectionChanged"
                                  ToolTip="Ginkgo 工作模式：硬件 I²C 用片上外设，软件 I²C 由 GPIO 模拟（速率较低）">
                            <ComboBoxItem Content="硬件 I²C" Tag="1" />
                            <ComboBoxItem Content="软件 I²C (GPIO)" Tag="2" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Margin="0,0,10,0">
                        <TextBlock Text="通道" FontSize="10" Opacity="0.55" Margin="0,0,0,3" />
                        <ComboBox x:Name="CmbChannel" MinWidth="92" SelectionChanged="CmbChannel_SelectionChanged" ToolTip="通道" />
                    </StackPanel>
                    <StackPanel Margin="0,0,14,0">
                        <TextBlock Text="速率" FontSize="10" Opacity="0.55" Margin="0,0,0,3" />
                        <ComboBox x:Name="CmbSpeed" MinWidth="112" SelectionChanged="CmbSpeed_SelectionChanged" ToolTip="速率">
                            <ComboBoxItem Content="100 kHz" Tag="100000" />
                            <ComboBoxItem Content="400 kHz" Tag="400000" />
                            <ComboBoxItem Content="1 MHz" Tag="1000000" />
                            <ComboBoxItem Content="1.2 MHz" Tag="1200000" />
                        </ComboBox>
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center" Margin="0,14,0,0">
                        <ui:ToggleSwitch x:Name="TglNonStd" Content="自定义频率"
                                         Checked="TglNonStd_Changed" Unchecked="TglNonStd_Changed" />
                    </StackPanel>
                    <Grid Margin="10,14,0,0">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=TglNonStd}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="TxtCustomHz" Text="200000" IsEnabled="False" />
                        <ui:Button x:Name="BtnApplyHz" Grid.Column="1" Content="应用" IsEnabled="False"
                                   Click="BtnApplyHz_Click" Margin="6,0,0,0" />
                    </Grid>
                </WrapPanel>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="300" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="ControlColumn" Width="0" MinWidth="0" MaxWidth="560" />
            </Grid.ColumnDefinitions>

            <!-- ── 扩展检查器：放在右侧，基础事务始终占据左侧主工作区；表格随窗口高度伸展。 ── -->
            <Grid x:Name="ExtPanel" Grid.Column="2" Visibility="Collapsed" Margin="4,0,0,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <ui:Card Margin="0,0,0,8">
                        <Grid Margin="10,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock x:Name="TxtExtSlaveLabel" Text="从机地址 · 7-bit" FontSize="10.5" Opacity="0.62" Margin="0,0,0,4" />
                                <ui:TextBox x:Name="TxtSlave" Text="49" MaxLength="2" FontFamily="Consolas"
                                            TextChanged="TxtSlave_TextChanged" ToolTip="从机地址，HEX 格式" />
                                <TextBlock x:Name="TxtExtAddressFeedback" FontSize="10" Foreground="{DynamicResource StatusErrorBrush}"
                                           TextTrimming="CharacterEllipsis" Visibility="Collapsed" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="寄存器地址宽度" FontSize="10.5" Opacity="0.62" Margin="0,0,0,4" />
                                <ComboBox x:Name="CmbRegWidth" SelectedIndex="0" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="8-bit · 00–FF" Tag="1" />
                                    <ComboBoxItem Content="16-bit · 0000–FFFF" Tag="2" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                    </ui:Card>

                    <StackPanel Grid.Row="1" Margin="4,0,0,8">
                    <Border Padding="3" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" Margin="0,0,0,7">
                        <UniformGrid Rows="1">
                            <ui:Button x:Name="BtnSubReg" Content="寄存器表" Appearance="Primary" Click="BtnSubReg_Click" CornerRadius="6" />
                            <ui:Button x:Name="BtnSubInit" Content="初始化序列" Click="BtnSubInit_Click" CornerRadius="6" />
                        </UniformGrid>
                    </Border>
                    <Grid Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Profile" VerticalAlignment="Center" Opacity="0.62" Margin="0,0,8,0" />
                        <ComboBox x:Name="CmbProfile" Grid.Column="1" MinWidth="90" Margin="0,0,6,0" IsEditable="True"
                                  ToolTip="选择已有 Profile，或输入新名称后保存" />
                        <ui:Button x:Name="BtnLoad" Grid.Column="2" Width="34" Margin="0,0,5,0" Click="BtnLoad_Click" ToolTip="载入 Profile">
                            <ui:SymbolIcon Symbol="FolderOpen24" FontSize="14" />
                        </ui:Button>
                        <ui:Button x:Name="BtnSave" Grid.Column="3" Width="34" Margin="0,0,5,0" Click="BtnSave_Click" ToolTip="保存或另存当前 Profile">
                            <ui:SymbolIcon Symbol="Save24" FontSize="14" />
                        </ui:Button>
                        <ui:Button x:Name="BtnDelete" Grid.Column="4" Width="34" Click="BtnDelete_Click" ToolTip="删除当前 Profile">
                            <ui:SymbolIcon Symbol="Delete24" FontSize="14" />
                        </ui:Button>
                    </Grid>
                    <Border Height="30" Padding="8,4" CornerRadius="8" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                        <TextBlock x:Name="TxtExtStatus" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                   ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    </Border>
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <!-- 寄存器表 -->
                        <Grid x:Name="RegHost">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DockPanel LastChildFill="True">
                                    <ui:Button x:Name="BtnReadAll" Content="一键读取全部" Appearance="Primary" Focusable="False"
                                               Click="BtnReadAll_Click" MinWidth="110" DockPanel.Dock="Right" />
                                    <ui:Button x:Name="BtnStopPolling" Content="停止轮询" Appearance="Danger"
                                               Click="BtnStopPolling_Click" Width="92" Margin="0,0,8,0"
                                               DockPanel.Dock="Right" Visibility="Hidden" />
                                    <TextBlock x:Name="TxtRegSummary" Text="寄存器列表 · 0 项" FontWeight="SemiBold" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <WrapPanel Grid.Row="1" Margin="0,7,0,0">
                                    <ui:Button x:Name="BtnAddRow" Content="添加行" Click="BtnAddRow_Click" Margin="0,0,7,0" />
                                    <ui:Button x:Name="BtnDelRow" Content="删除选中" Click="BtnDelRow_Click"
                                               IsEnabled="False" Margin="0,0,7,0" />
                                    <ui:Button x:Name="BtnDuplicateRow" Content="复制" Click="BtnDuplicateRow_Click"
                                               IsEnabled="False" Margin="0,0,7,0" ToolTip="复制选中行 (Ctrl+D)" />
                                    <ui:Button x:Name="BtnMoveRowUp" Content="↑" Click="BtnMoveRowUp_Click" Width="34"
                                               IsEnabled="False" Margin="0,0,4,0" ToolTip="上移选中行" />
                                    <ui:Button x:Name="BtnMoveRowDown" Content="↓" Click="BtnMoveRowDown_Click" Width="34"
                                               IsEnabled="False" Margin="0,0,7,0" ToolTip="下移选中行" />
                                    <ui:Button x:Name="BtnUndoRow" Content="撤销" Click="BtnUndoRow_Click"
                                               IsEnabled="False" Margin="0,0,7,0" ToolTip="恢复最近删除的行 (Ctrl+Z)" />
                                    <ui:Button x:Name="BtnSaveSnapshot" Content="保存快照" Click="BtnSaveSnapshot_Click"
                                               Margin="0,0,9,0" ToolTip="保存本次成功读取的值；下次“一键读取全部”时自动标出变化" />
                                    <TextBlock x:Name="TxtSnapshotState" Text="未保存快照" FontSize="10.5" Opacity="0.56"
                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                </WrapPanel>
                            </Grid>
                            <Grid Grid.Row="1">
                            <DataGrid x:Name="GridReg" AutoGenerateColumns="False" CanUserAddRows="False"
                                      HeadersVisibility="Column" MinHeight="200" FrozenColumnCount="6"
                                      SelectionChanged="GridReg_SelectionChanged"
                                      PreparingCellForEdit="Grid_PreparingCellForEdit"
                                      CellEditEnding="Grid_CellEditEnding"
                                      PreviewKeyDown="GridReg_PreviewKeyDown"
                                      SelectionUnit="FullRow" RowStyle="{StaticResource ExtDataGridRowStyle}"
                                      CellStyle="{StaticResource ExtDataGridCellStyle}"
                                      RowBackground="Transparent" AlternatingRowBackground="{DynamicResource ControlFillColorSecondaryBrush}"
                                      Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                                      ColumnHeaderStyle="{StaticResource ExtDataGridHeaderStyle}"
                                      FontFamily="Consolas" FontSize="12" RowHeight="36" ColumnHeaderHeight="30"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                <!-- 列序：操作列前置、值列殿后弹性——窄面板下被压缩/滚出的只会是数据列，执行始终可见。 -->
                                <DataGridTextColumn Header="Reg/HEX" Binding="{Binding Reg}" Width="68"
                                                    ElementStyle="{StaticResource ExtCenteredTextStyle}" EditingElementStyle="{StaticResource ExtEditTextStyle}" />
                                <DataGridTextColumn Header="长度/B" Binding="{Binding Len}" Width="64"
                                                    ElementStyle="{StaticResource ExtCenteredNumberTextStyle}" EditingElementStyle="{StaticResource ExtNumberEditTextStyle}" />
                                <DataGridTextColumn Header="周期/ms" Binding="{Binding PeriodMs}" Width="66"
                                                    ElementStyle="{StaticResource ExtCenteredNumberTextStyle}" EditingElementStyle="{StaticResource ExtNumberEditTextStyle}" />
                                    <DataGridTemplateColumn Header="读写" Width="68">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                            <ComboBox SelectedIndex="{Binding Dir, Converter={StaticResource DirIndex}, Mode=TwoWay}" FontSize="12" MinWidth="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                                <ComboBoxItem Content="R" />
                                                <ComboBoxItem Content="W" />
                                            </ComboBox>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                <DataGridTextColumn Header="状态/ms" Binding="{Binding StatusDisplay}" Width="76"
                                                    ElementStyle="{StaticResource RowStatusStyle}" IsReadOnly="True" />
                                    <DataGridTemplateColumn Header="执行" Width="56">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                            <Button Content="{Binding ExecuteText}" ToolTip="{Binding ExecuteToolTip}" Click="BtnRowExec_Click" Width="52" Padding="1" Margin="1" Focusable="False"
                                                    IsEnabled="{Binding CanExecute}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                <DataGridTextColumn Header="值/HEX" Binding="{Binding Value}" Width="*" MinWidth="90"
                                                    ElementStyle="{StaticResource ExtHexTrimStyle}" EditingElementStyle="{StaticResource ExtEditTextStyle}" />
                                <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="120"
                                                    ElementStyle="{StaticResource ExtNoteTrimStyle}" EditingElementStyle="{StaticResource ExtEditTextStyle}" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel x:Name="TxtRegEmpty" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="Collapsed">
                                <TextBlock Text="尚无寄存器项" FontSize="13" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="添加第一项，或从上方 Profile 载入已有配置" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,5,0,10" />
                                <ui:Button Content="添加第一个寄存器" Appearance="Primary" HorizontalAlignment="Center"
                                           Click="BtnAddRow_Click" IsEnabled="{Binding IsEnabled, ElementName=BtnAddRow}" />
                            </StackPanel>
                            </Grid>
                        </Grid>

                        <!-- 初始化序列 -->
                        <Grid x:Name="InitHost" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <DockPanel LastChildFill="True">
                                    <ui:Button x:Name="BtnRunInit" Content="一键初始化" Appearance="Primary"
                                               Click="BtnRunInit_Click" MinWidth="110" DockPanel.Dock="Right" />
                                    <ui:Button x:Name="BtnStopInit" Content="停止任务" Appearance="Danger"
                                               Click="BtnStopPolling_Click" Width="92" Margin="0,0,8,0"
                                               DockPanel.Dock="Right" Visibility="Hidden" />
                                    <TextBlock x:Name="TxtInitSummary" Text="初始化步骤 · 0 项" FontWeight="SemiBold" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" />
                                </DockPanel>
                                <WrapPanel Grid.Row="1" Margin="0,7,0,0">
                                    <ui:Button x:Name="BtnAddInit" Content="添加行" Click="BtnAddInit_Click" Margin="0,0,7,0" />
                                    <ui:Button x:Name="BtnDelInit" Content="删除选中" Click="BtnDelInit_Click"
                                               IsEnabled="False" Margin="0,0,7,0" />
                                    <ui:Button x:Name="BtnDuplicateInit" Content="复制" Click="BtnDuplicateInit_Click"
                                               IsEnabled="False" Margin="0,0,7,0" ToolTip="复制选中步骤 (Ctrl+D)" />
                                    <ui:Button x:Name="BtnMoveInitUp" Content="↑" Click="BtnMoveInitUp_Click" Width="34"
                                               IsEnabled="False" Margin="0,0,4,0" ToolTip="上移选中步骤" />
                                    <ui:Button x:Name="BtnMoveInitDown" Content="↓" Click="BtnMoveInitDown_Click" Width="34"
                                               IsEnabled="False" Margin="0,0,7,0" ToolTip="下移选中步骤" />
                                    <ui:Button x:Name="BtnUndoInit" Content="撤销" Click="BtnUndoInit_Click"
                                               IsEnabled="False" ToolTip="恢复最近删除的步骤 (Ctrl+Z)" />
                                </WrapPanel>
                            </Grid>
                            <Grid Grid.Row="1">
                            <DataGrid x:Name="GridInit" AutoGenerateColumns="False" CanUserAddRows="False"
                                      HeadersVisibility="Column" MinHeight="200" FrozenColumnCount="6"
                                      SelectionChanged="GridInit_SelectionChanged"
                                      PreparingCellForEdit="Grid_PreparingCellForEdit"
                                      CellEditEnding="Grid_CellEditEnding"
                                      PreviewKeyDown="GridInit_PreviewKeyDown"
                                      SelectionUnit="FullRow" RowStyle="{StaticResource ExtDataGridRowStyle}"
                                      CellStyle="{StaticResource ExtDataGridCellStyle}"
                                      RowBackground="Transparent" AlternatingRowBackground="{DynamicResource ControlFillColorSecondaryBrush}"
                                      Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"
                                      ColumnHeaderStyle="{StaticResource ExtDataGridHeaderStyle}"
                                      FontFamily="Consolas" FontSize="12" RowHeight="36" ColumnHeaderHeight="30">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="延时/ms" Binding="{Binding DelayMs}" Width="66"
                                                    ElementStyle="{StaticResource ExtCenteredNumberTextStyle}" EditingElementStyle="{StaticResource ExtNumberEditTextStyle}" />
                                <DataGridTextColumn Header="Reg/HEX" Binding="{Binding Reg}" Width="68"
                                                    ElementStyle="{StaticResource ExtCenteredTextStyle}" EditingElementStyle="{StaticResource ExtEditTextStyle}" />
                                <DataGridTextColumn Header="长度/B" Binding="{Binding Len}" Width="64"
                                                    ElementStyle="{StaticResource ExtCenteredNumberTextStyle}" EditingElementStyle="{StaticResource ExtNumberEditTextStyle}" />
                                <DataGridTemplateColumn Header="读写" Width="68">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox SelectedIndex="{Binding Dir, Converter={StaticResource DirIndex}, Mode=TwoWay}" FontSize="12" MinWidth="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center">
                                                <ComboBoxItem Content="R" />
                                                <ComboBoxItem Content="W" />
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="状态/ms" Binding="{Binding StatusDisplay}" Width="76"
                                                    ElementStyle="{StaticResource RowStatusStyle}" IsReadOnly="True" />
                                <DataGridTemplateColumn Header="执行" Width="56">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="执行" Click="BtnInitRowExec_Click" Width="52" Padding="1" Margin="1" Focusable="False"
                                                    IsEnabled="{Binding CanExecuteExtended, RelativeSource={RelativeSource AncestorType={x:Type views:I2cPage}}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="数据/HEX" Binding="{Binding Value}" Width="*" MinWidth="90"
                                                    ElementStyle="{StaticResource ExtHexTrimStyle}" EditingElementStyle="{StaticResource ExtEditTextStyle}" />
                                <DataGridTextColumn Header="备注" Binding="{Binding Note}" Width="120"
                                                    ElementStyle="{StaticResource ExtNoteTrimStyle}" EditingElementStyle="{StaticResource ExtEditTextStyle}" />
                            </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel x:Name="TxtInitEmpty" HorizontalAlignment="Center" VerticalAlignment="Center"
                                        Visibility="Collapsed">
                                <TextBlock Text="尚无初始化步骤" FontSize="13" FontWeight="SemiBold"
                                           HorizontalAlignment="Center" />
                                <TextBlock Text="添加第一步，完成后可保存为可复用的 Profile" FontSize="11"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           HorizontalAlignment="Center" Margin="0,5,0,10" />
                                <ui:Button Content="添加第一个步骤" Appearance="Primary" HorizontalAlignment="Center"
                                           Click="BtnAddInit_Click" IsEnabled="{Binding IsEnabled, ElementName=BtnAddInit}" />
                            </StackPanel>
                            </Grid>
                        </Grid>

                    </Grid>
            </Grid>

            <GridSplitter x:Name="PanelSplitter" Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Visibility="Collapsed"
                          Style="{StaticResource WorkspaceSplitterStyle}"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                          Cursor="SizeWE" ShowsPreview="False"
                          DragCompleted="PanelSplitter_DragCompleted"
                          MouseDoubleClick="Splitter_DoubleClick" ToolTip="拖拽调整 · 双击复位" />

            <!-- 主工作区按「编辑事务 → 查看证据」排列，操作完成后视线自然落到最新日志。 -->
            <Grid Grid.Column="0" MinWidth="300" Margin="4,2,0,10">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="DataRow" Height="7*" MinHeight="190" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="LogRow" Height="13*" MinHeight="180" />
                </Grid.RowDefinitions>

                <!-- 数据操作：目标参数 | 命令编辑器 | 读取结果。Border 代替 ui:Card：其模板把内容垂直居中，拖大分隔条后内容会悬浮。 -->
                <Border x:Name="DataOperationsCard" Grid.Row="0" VerticalAlignment="Stretch"
                        Background="{DynamicResource ControlFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12"
                        Margin="0,0,0,8" Padding="14,12"
                        KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="86" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 宽窗口双列；可用空间不足时由代码切成两行，组内再自动换行，避免横向滚动。 -->
                        <Grid x:Name="CommandGroups" Grid.Row="0" Margin="0,0,0,6" UseLayoutRounding="True" SnapsToDevicePixels="True">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="2*" MinWidth="400" />
                            </Grid.ColumnDefinitions>
                                <Border x:Name="DataTargetGroup" Grid.Row="0" Grid.Column="0" Style="{StaticResource DataGroupStyle}">
                                    <Grid x:Name="TargetFieldsGrid" VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <!-- 每个字段组由响应式代码整组换行，不允许单个输入框随机掉队。 -->
                                        <StackPanel x:Name="TargetSavedGroup" Grid.Column="0" Orientation="Horizontal" Margin="0,0,10,0">
                                            <TextBlock Text="目标" Style="{StaticResource DataGroupHeadingStyle}" Margin="0,0,8,0" />
                                            <Grid Width="154">
                                                <ComboBox x:Name="CmbTarget" DisplayMemberPath="Display"
                                                          SelectionChanged="CmbTarget_SelectionChanged"
                                                          ToolTip="选择目标会同步从机地址和寄存器工具" />
                                                <TextBlock x:Name="TxtTargetEmpty" Text="选择已保存目标"
                                                           Margin="8,0,26,0" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" IsHitTestVisible="False" />
                                            </Grid>
                                            <ui:Button x:Name="BtnSaveTarget" Width="74" Margin="7,0,0,0"
                                                       Click="BtnSaveTarget_Click" ToolTip="将当前从机地址保存到目标列表">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="Bookmark24" FontSize="14" Margin="0,0,5,0" />
                                                    <TextBlock Text="保存" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </ui:Button>
                                            <ui:Button x:Name="BtnRemoveTarget" Width="74" Margin="5,0,0,0" Focusable="False"
                                                       Click="BtnRemoveTarget_Click" ToolTip="从目标列表移除当前选中的已保存目标">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="BookmarkOff24" FontSize="14" Margin="0,0,5,0" />
                                                    <TextBlock Text="移除" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </ui:Button>
                                        </StackPanel>
                                        <StackPanel x:Name="TargetAddressGroup" Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,0">
                                            <TextBlock Text="地址" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,5,0"
                                                       ToolTip="从机地址，HEX 格式" />
                                            <ui:TextBox x:Name="TxtAddr" Width="66" MaxLength="2" Style="{StaticResource CommandInputStyle}" Margin="0,0,8,0"
                                                        TextChanged="TxtAddr_TextChanged" LostFocus="TargetInput_LostFocus"
                                                        GotKeyboardFocus="Input_GotKeyboardFocus" KeyDown="FieldBox_KeyDown"
                                                        PlaceholderText="49" ToolTip="从机地址，HEX 格式；回车 = 读取" />
                                            <ui:Button x:Name="BtnScanBus" Click="BtnScan_Click" IsEnabled="False" Width="86" Focusable="False"
                                                       ToolTip="扫描当前通道上的从机地址 (F5)；扫描中按 F5、Esc 或点击可中止">
                                                <Grid>
                                                    <StackPanel x:Name="PnlScanNormal" Orientation="Horizontal">
                                                        <ui:SymbolIcon Symbol="Search24" FontSize="14" Margin="0,0,5,0" />
                                                        <TextBlock Text="扫描" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <StackPanel x:Name="PnlScanCancel" Orientation="Horizontal" Visibility="Hidden">
                                                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Margin="0,0,5,0" />
                                                        <TextBlock Text="停止" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Grid>
                                            </ui:Button>
                                        </StackPanel>
                                        <StackPanel x:Name="TargetFormatGroup" Grid.Column="2" Orientation="Horizontal" Margin="0,0,8,0">
                                            <TextBlock Text="格式" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                            <ComboBox x:Name="CmbAddrFmt" SelectedIndex="0" Width="88"
                                                      SelectionChanged="CmbAddrFmt_SelectionChanged"
                                                      ToolTip="从机地址显示格式：7-bit 为原始地址，8-bit 为读写合成地址（7-bit 左移 1 位）">
                                                <ComboBoxItem Content="7-bit" />
                                                <ComboBoxItem Content="8-bit" />
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel x:Name="TargetRegisterGroup" Grid.Column="3" Orientation="Horizontal">
                                            <TextBlock Text="寄存器" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,5,0"
                                                       ToolTip="寄存器号（子地址），HEX 格式。留空 = 原始读写" />
                                            <ui:TextBox x:Name="TxtSubAddr" Text="00" MaxLength="2" Width="72" Style="{StaticResource CommandInputStyle}"
                                                        TextChanged="TxtSubAddr_TextChanged" LostFocus="TargetInput_LostFocus"
                                                        GotKeyboardFocus="Input_GotKeyboardFocus" KeyDown="FieldBox_KeyDown"
                                                        PlaceholderText="00" ToolTip="寄存器地址，HEX 格式；留空时为原始读写；回车 = 读取" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border x:Name="DataTransferGroup" Grid.Row="0" Grid.Column="1" Style="{StaticResource DataGroupStyle}" Margin="10,0,0,0">
                                    <Grid x:Name="TransferFieldsGrid" VerticalAlignment="Center">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock x:Name="TransferHeading" Grid.Column="0" Text="事务操作" Style="{StaticResource DataGroupHeadingStyle}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <StackPanel x:Name="TransferLengthGroup" Grid.Column="1" Orientation="Horizontal" Margin="0,0,12,0">
                                            <TextBlock Text="长度" Style="{StaticResource FieldLabelStyle}" VerticalAlignment="Center" Margin="0,0,5,0" />
                                            <ui:TextBox x:Name="TxtReadSize" Text="8" Width="54" MaxLength="3" Style="{StaticResource CommandInputStyle}"
                                                        TextChanged="TxtReadSize_TextChanged" LostFocus="DataInput_LostFocus"
                                                        GotKeyboardFocus="Input_GotKeyboardFocus" KeyDown="FieldBox_KeyDown"
                                                        ToolTip="每次读取 1–256 字节；回车 = 读取" />
                                        </StackPanel>
                                        <CheckBox x:Name="ChkWriteRead" Grid.Column="2" Content="写后读取" VerticalAlignment="Center" Margin="0,0,12,0"
                                                  Checked="TransactionContext_Changed" Unchecked="TransactionContext_Changed" />
                                        <Border x:Name="TransferActionDivider" Grid.Column="3" Width="1" Height="22" Background="{DynamicResource ControlStrokeColorDefaultBrush}" Margin="0,0,12,0" />
                                        <StackPanel x:Name="TransferActions" Grid.Column="4" Orientation="Horizontal">
                                            <ui:Button x:Name="BtnRead" Click="BtnRead_Click" IsEnabled="False" MinWidth="86" Margin="0,0,6,0" Focusable="False"
                                                       ToolTip="读取数据 (Ctrl+R)">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="14" Margin="0,0,5,0" />
                                                    <TextBlock Text="读取" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </ui:Button>
                                            <ui:Button x:Name="BtnWrite" IsEnabled="False" Click="BtnWrite_Click" MinWidth="86" Focusable="False"
                                                       ToolTip="写入数据 (Ctrl+W)">
                                                <StackPanel Orientation="Horizontal">
                                                    <ui:SymbolIcon Symbol="ArrowUpload24" FontSize="14" Margin="0,0,5,0" />
                                                    <TextBlock Text="写入" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </ui:Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                        </Grid>

                        <!-- 数据输入与结果共用同一缓冲区；标题固定显示，避免新用户误以为只读结果区不可编辑。 -->
                        <StackPanel Grid.Row="2" Margin="0,0,0,5">
                            <DockPanel>
                                <TextBlock Text="数据缓冲区" FontWeight="SemiBold" FontSize="12" Opacity="0.82" />
                                <TextBlock DockPanel.Dock="Right" Text="HEX · 空格、逗号或换行分隔" FontSize="10" Opacity="0.48" />
                                <TextBlock x:Name="TxtBufferMeta" DockPanel.Dock="Right" Text="0 B" FontFamily="Consolas" FontSize="10"
                                           Margin="0,0,12,0" Opacity="0.62" />
                                <TextBlock x:Name="TxtBufferDelta" DockPanel.Dock="Right" FontFamily="Consolas" FontSize="10"
                                           Margin="0,0,12,0" Opacity="0.78" Visibility="Collapsed"
                                           Foreground="{DynamicResource StatusLiveBrush}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <TextBlock x:Name="TxtBufferAscii" Text="ASCII · —" FontFamily="Consolas" FontSize="10"
                                       Margin="0,3,0,0" Opacity="0.58" TextTrimming="CharacterEllipsis"
                                       ToolTip="ASCII 预览：不可打印字节显示为 ·" />
                        </StackPanel>
                        <ui:TextBox x:Name="TxtDataBuffer" Grid.Row="3" Text="DE AD BE EF"
                                    FontFamily="Consolas" FontSize="14" AcceptsReturn="True" MinHeight="94"
                                    TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                    VerticalContentAlignment="Top" TextChanged="TxtDataBuffer_TextChanged"
                                    LostFocus="DataInput_LostFocus" GotKeyboardFocus="Input_GotKeyboardFocus"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    PlaceholderText="输入待写数据，例如 DE AD BE EF；读取结果会显示在这里"
                                    ToolTip="以空格、逗号或换行分隔 HEX 字节" />

                        <Border Grid.Row="4" Margin="0,8,0,0" Padding="8,6" CornerRadius="8"
                                Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <DockPanel>
                                <TextBlock x:Name="TxtDataStatus" Text="输入数据后写入，或直接读取"
                                           FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <!-- 最近事务与编辑缓冲区解耦：结果被下一次输入覆盖后，仍能快速确认刚刚发生的总线操作。 -->
                            <Border x:Name="LastTransactionPanel" Grid.Row="1" Visibility="Collapsed" Margin="0,8,0,0" Padding="8,6"
                                    CornerRadius="8" Background="{DynamicResource ControlFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="最近事务" FontSize="10" Opacity="0.52" VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock x:Name="TxtLastTransaction" Grid.Column="1" FontFamily="Consolas" FontSize="11"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <ui:Button x:Name="BtnCopyLastTransaction" Grid.Column="2" Content="复制" FontSize="10" Padding="7,1"
                                               Margin="8,0,0,0" Click="BtnCopyLastTransaction_Click" ToolTip="复制最近事务完整信息（Ctrl+C）" />
                                </Grid>
                            </Border>
                        </Grid>
                        </Border>
                    </Grid>
                </Border>

                <GridSplitter x:Name="LogSplitter" Grid.Row="1" Height="8"
                              HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              Style="{StaticResource WorkspaceSplitterStyle}"
                              ResizeDirection="Rows" Cursor="SizeNS"
                              ResizeBehavior="PreviousAndNext" ShowsPreview="True"
                              DragCompleted="LogSplitter_DragCompleted"
                              MouseDoubleClick="LogSplitter_DoubleClick"
                              ToolTip="上下拖动调整区域 · 双击复位" />

                <views:LogPanel x:Name="LogView" Grid.Row="2" />
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>

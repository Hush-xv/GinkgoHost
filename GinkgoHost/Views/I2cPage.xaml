<UserControl x:Class="GinkgoHost.Views.I2cPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:views="clr-namespace:GinkgoHost.Views"
             Focusable="True" PreviewKeyDown="I2cPage_PreviewKeyDown">
    <UserControl.Resources>
        <!-- 行状态文字：OK 绿 / ERR 红 -->
        <Style x:Key="RowStatusStyle" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#81C784" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="ERR">
                    <Setter Property="Foreground" Value="#EF5350" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 扩展表格保持整行选中提示，避免单元格默认色遮挡当前操作行。 -->
        <Style x:Key="ExtDataGridRowStyle" TargetType="DataGridRow">
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#443B2F7A" />
                    <Setter Property="BorderBrush" Value="#9A86FD" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ExtDataGridCellStyle" TargetType="DataGridCell">
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <!-- ═══ 总线设置条 ═══ -->
        <Border DockPanel.Dock="Top" Margin="8,0,8,8" CornerRadius="6" Padding="12,6"
                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Right" CornerRadius="6"
                        Background="{DynamicResource ControlFillColorDefaultBrush}" Padding="3" Margin="14,0,0,0">
                    <UniformGrid Rows="1">
                        <ui:Button x:Name="BtnTabMain" Content="基础操作" Appearance="Primary"
                                   Click="BtnTabMain_Click" CornerRadius="4,0,0,4" />
                        <ui:Button x:Name="BtnTabExt" Content="寄存器工具"
                                   Click="BtnTabExt_Click" CornerRadius="0,4,4,0" />
                    </UniformGrid>
                </Border>
                <WrapPanel VerticalAlignment="Center">
                    <TextBlock Text="模式" VerticalAlignment="Center" Opacity="0.65" />
                    <ComboBox x:Name="CmbCtrlMode" MinWidth="120" Margin="8,0,16,0" SelectionChanged="CmbCtrlMode_SelectionChanged">
                        <ComboBoxItem Content="硬件 I²C" Tag="1" />
                        <ComboBoxItem Content="软件 I²C (GPIO)" Tag="2" />
                    </ComboBox>
                    <TextBlock Text="通道" VerticalAlignment="Center" Opacity="0.65" />
                    <ComboBox x:Name="CmbChannel" MinWidth="92" Margin="8,0,16,0" SelectionChanged="CmbChannel_SelectionChanged" />
                    <TextBlock Text="速率" VerticalAlignment="Center" Opacity="0.65" />
                    <ComboBox x:Name="CmbSpeed" MinWidth="110" Margin="8,0,16,0" SelectionChanged="CmbSpeed_SelectionChanged">
                        <ComboBoxItem Content="100 kHz" Tag="100000" />
                        <ComboBoxItem Content="400 kHz" Tag="400000" />
                        <ComboBoxItem Content="1 MHz" Tag="1000000" />
                        <ComboBoxItem Content="1.2 MHz" Tag="1200000" />
                    </ComboBox>
                    <ui:ToggleSwitch x:Name="TglNonStd" Content="自定义频率" VerticalAlignment="Center"
                                     Checked="TglNonStd_Changed" Unchecked="TglNonStd_Changed" />
                    <Grid Margin="10,0,0,0">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsChecked, ElementName=TglNonStd}" Value="True">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:TextBox x:Name="TxtCustomHz" Text="200000" IsEnabled="False" />
                        <ui:Button x:Name="BtnApplyHz" Grid.Column="1" Content="应用" IsEnabled="False"
                                   Click="BtnApplyHz_Click" Margin="6,0,0,0" />
                    </Grid>
                </WrapPanel>
            </DockPanel>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ControlColumn" Width="0" MinWidth="0" MaxWidth="560" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <!-- ── 扩展面板 ── -->
            <Grid x:Name="ExtPanel" Grid.Column="0" Visibility="Collapsed" Margin="0,0,4,12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <ui:Card Margin="0,0,0,10">
                        <WrapPanel Margin="4">
                            <TextBlock x:Name="TxtExtSlaveLabel" Text="从机地址 · 7-bit" VerticalAlignment="Center" Opacity="0.75" />
                            <ui:TextBox x:Name="TxtSlave" Text="49" Width="64" MaxLength="2" Margin="8,0,16,0"
                                        TextChanged="TxtSlave_TextChanged" />
                            <TextBlock Text="寄存器地址宽度" VerticalAlignment="Center" Opacity="0.75" />
                            <ComboBox x:Name="CmbRegWidth" SelectedIndex="0" MinWidth="100" Margin="8,0,16,0">
                                <ComboBoxItem Content="Reg 8Bit" Tag="1" />
                                <ComboBoxItem Content="Reg 16Bit" Tag="2" />
                            </ComboBox>
                        </WrapPanel>
                    </ui:Card>

                    <StackPanel Grid.Row="1" Margin="4,0,0,6">
                    <WrapPanel>
                        <ui:Button x:Name="BtnSubReg" Content="寄存器表" Appearance="Primary"
                                   Click="BtnSubReg_Click" MinWidth="96" Margin="0,0,6,6" />
                        <ui:Button x:Name="BtnSubInit" Content="初始化序列"
                                   Click="BtnSubInit_Click" MinWidth="96" Margin="0,0,18,6" />
                        <TextBlock Text="Profile" VerticalAlignment="Center" Opacity="0.75" Margin="0,0,8,6" />
                        <ComboBox x:Name="CmbProfile" MinWidth="120" Margin="0,0,8,6" />
                        <ui:Button x:Name="BtnSave" Content="保存" Click="BtnSave_Click" MinWidth="64" Margin="0,0,6,6" />
                        <ui:Button x:Name="BtnLoad" Content="载入" Click="BtnLoad_Click" MinWidth="64" Margin="0,0,6,6" />
                        <ui:Button x:Name="BtnDelete" Content="删除" Click="BtnDelete_Click" MinWidth="64" Margin="0,0,0,6" />
                    </WrapPanel>
                    <TextBlock x:Name="TxtExtStatus" FontSize="12" Opacity="0.68" Margin="0,0,0,4" />
                    </StackPanel>

                    <Grid Grid.Row="2">
                        <!-- 寄存器表 -->
                        <Grid x:Name="RegHost">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,6" LastChildFill="False">
                                <ui:Button x:Name="BtnAddRow" Content="添加行" Click="BtnAddRow_Click" />
                                <ui:Button x:Name="BtnDelRow" Content="删除选中" Click="BtnDelRow_Click"
                                           IsEnabled="False" Margin="8,0,12,0" />
                                <ui:Button x:Name="BtnReadAll" Content="一键读取全部" Appearance="Primary"
                                           Click="BtnReadAll_Click" MinWidth="110" DockPanel.Dock="Right" />
                                <ui:Button x:Name="BtnStopPolling" Content="停止轮询" Appearance="Danger"
                                           Click="BtnStopPolling_Click" MinWidth="92" Margin="0,0,8,0"
                                           DockPanel.Dock="Right" Visibility="Collapsed" />
                            </DockPanel>
                            <Grid Grid.Row="1">
                            <DataGrid x:Name="GridReg" AutoGenerateColumns="False" CanUserAddRows="False"
                                      HeadersVisibility="Column" MinHeight="200"
                                      SelectionChanged="GridReg_SelectionChanged"
                                      SelectionUnit="FullRow" RowStyle="{StaticResource ExtDataGridRowStyle}"
                                      CellStyle="{StaticResource ExtDataGridCellStyle}"
                                      RowBackground="Transparent" AlternatingRowBackground="#0AFFFFFF"
                                      FontFamily="Consolas" FontSize="12"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                <DataGridTextColumn Header="Reg" Binding="{Binding Reg}" Width="60" />
                                <DataGridTextColumn Header="长度" Binding="{Binding Len}" Width="44" />
                                <DataGridTextColumn Header="周期" Binding="{Binding PeriodMs}" Width="56" />
                                <DataGridTextColumn Header="值" Binding="{Binding Value}" Width="*" MinWidth="88" />
                                    <DataGridTemplateColumn Header="读写" Width="56">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                            <ComboBox SelectedIndex="{Binding Dir, Converter={StaticResource DirIndex}, Mode=TwoWay}" FontSize="12">
                                                <ComboBoxItem Content="R" />
                                                <ComboBoxItem Content="W" />
                                            </ComboBox>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="50"
                                                        ElementStyle="{StaticResource RowStatusStyle}" IsReadOnly="True" />
                                <DataGridTemplateColumn Header="执行" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="执行" Click="BtnRowExec_Click" Width="56" Padding="2" Margin="2"
                                                    IsEnabled="{Binding CanExecuteExtended, RelativeSource={RelativeSource AncestorType={x:Type views:I2cPage}}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="TxtRegEmpty" Text="尚无寄存器项 · 点击“添加行”开始配置"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.55"
                                       IsHitTestVisible="False" Visibility="Collapsed" />
                            </Grid>
                        </Grid>

                        <!-- 初始化序列 -->
                        <Grid x:Name="InitHost" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <DockPanel Margin="0,0,0,6" LastChildFill="False">
                                <ui:Button x:Name="BtnAddInit" Content="添加行" Click="BtnAddInit_Click" />
                                <ui:Button x:Name="BtnDelInit" Content="删除选中" Click="BtnDelInit_Click"
                                           IsEnabled="False" Margin="8,0,12,0" />
                                <ui:Button x:Name="BtnRunInit" Content="一键初始化" Appearance="Primary"
                                           Click="BtnRunInit_Click" MinWidth="110" DockPanel.Dock="Right" />
                            </DockPanel>
                            <Grid Grid.Row="1">
                            <DataGrid x:Name="GridInit" AutoGenerateColumns="False" CanUserAddRows="False"
                                      HeadersVisibility="Column" MinHeight="200"
                                      SelectionChanged="GridInit_SelectionChanged"
                                      SelectionUnit="FullRow" RowStyle="{StaticResource ExtDataGridRowStyle}"
                                      CellStyle="{StaticResource ExtDataGridCellStyle}"
                                      RowBackground="Transparent" AlternatingRowBackground="#0AFFFFFF"
                                      FontFamily="Consolas" FontSize="12">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="延时" Binding="{Binding DelayMs}" Width="56" />
                                <DataGridTextColumn Header="Reg" Binding="{Binding Reg}" Width="60" />
                                <DataGridTextColumn Header="长度" Binding="{Binding Len}" Width="44" />
                                <DataGridTextColumn Header="数据" Binding="{Binding Value}" Width="*" MinWidth="88" />
                                <DataGridTemplateColumn Header="读写" Width="56">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ComboBox SelectedIndex="{Binding Dir, Converter={StaticResource DirIndex}, Mode=TwoWay}" FontSize="12">
                                                <ComboBoxItem Content="R" />
                                                <ComboBoxItem Content="W" />
                                            </ComboBox>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="50"
                                                    ElementStyle="{StaticResource RowStatusStyle}" IsReadOnly="True" />
                                <DataGridTemplateColumn Header="执行" Width="60">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="执行" Click="BtnInitRowExec_Click" Width="56" Padding="2" Margin="2"
                                                    IsEnabled="{Binding CanExecuteExtended, RelativeSource={RelativeSource AncestorType={x:Type views:I2cPage}}}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                            </DataGrid>
                            <TextBlock x:Name="TxtInitEmpty" Text="尚无初始化步骤 · 添加行后可保存为 Profile"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.55"
                                       IsHitTestVisible="False" Visibility="Collapsed" />
                            </Grid>
                        </Grid>

                    </Grid>
            </Grid>

            <GridSplitter x:Name="PanelSplitter" Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                          Visibility="Collapsed"
                          Style="{StaticResource WorkspaceSplitterStyle}"
                          ResizeBehavior="PreviousAndNext" ResizeDirection="Columns"
                          Cursor="SizeWE" ShowsPreview="True"
                          DragCompleted="PanelSplitter_DragCompleted"
                          MouseDoubleClick="Splitter_DoubleClick" ToolTip="拖拽调整 · 双击复位" />

            <Grid Grid.Column="2" MinWidth="300" Margin="0,4,4,12">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="LogRow" Height="13*" MinHeight="180" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="DataRow" Height="7*" MinHeight="190" />
                </Grid.RowDefinitions>
                <views:LogPanel x:Name="LogView" />

                <GridSplitter x:Name="LogSplitter" Grid.Row="1" Height="8"
                              HorizontalAlignment="Stretch" VerticalAlignment="Center"
                              Style="{StaticResource WorkspaceSplitterStyle}"
                              ResizeDirection="Rows" Cursor="SizeNS"
                              ResizeBehavior="PreviousAndNext" ShowsPreview="True"
                              DragCompleted="LogSplitter_DragCompleted"
                              MouseDoubleClick="LogSplitter_DoubleClick"
                              ToolTip="上下拖动调整区域 · 双击复位" />

                <!-- 数据操作：目标参数 | 命令编辑器 | 读取结果 -->
                <ui:Card x:Name="DataOperationsCard" Grid.Row="2" Margin="0,8,0,0" Padding="10,7">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" MinHeight="86" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Text="数据操作" FontWeight="SemiBold" Margin="0,0,0,7" />

                        <!-- 单行参数工具栏；空间不足时控件自动换行 -->
                        <WrapPanel Grid.Row="1" Margin="0,0,0,6"
                                   UseLayoutRounding="True" SnapsToDevicePixels="True">
                            <StackPanel Width="104" Margin="0,0,10,6">
                                <TextBlock Text="从机地址" Style="{StaticResource FieldLabelStyle}"
                                           ToolTip="7 位地址（hex），如 8 位标注的 0x92 请填 49" />
                                <ui:TextBox x:Name="TxtAddr" FontFamily="Consolas"
                                            TextChanged="TxtAddr_TextChanged"
                                            LostFocus="TargetInput_LostFocus" />
                            </StackPanel>
                            <StackPanel Width="94" Margin="0,0,10,6">
                                <TextBlock Text="地址格式" Style="{StaticResource FieldLabelStyle}" />
                                <ComboBox x:Name="CmbAddrFmt" SelectedIndex="0"
                                          SelectionChanged="CmbAddrFmt_SelectionChanged">
                                    <ComboBoxItem Content="7-bit" />
                                    <ComboBoxItem Content="8-bit" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Width="116" Margin="0,0,10,6">
                                <TextBlock Text="寄存器地址 · 0x" Style="{StaticResource FieldLabelStyle}"
                                           ToolTip="寄存器号（子地址）。留空 = 原始读写" />
                                <ui:TextBox x:Name="TxtSubAddr" Text="00" MaxLength="2" FontFamily="Consolas"
                                            TextChanged="TxtSubAddr_TextChanged"
                                            LostFocus="TargetInput_LostFocus" />
                            </StackPanel>
                            <ui:Button x:Name="BtnScanBus" Content="扫描总线" Click="BtnScan_Click" IsEnabled="False"
                                       Width="96" Margin="0,19,0,6" VerticalAlignment="Top"
                                       ToolTip="扫描当前通道上的从机地址 (F5)" />

                            <Border Width="1" Height="34" Margin="14,19,14,6"
                                    Background="{DynamicResource ControlStrokeColorDefaultBrush}" />
                            <Border Margin="0,13,0,6" Padding="8,5" CornerRadius="5"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                    BorderThickness="1">
                                <WrapPanel>
                                <TextBlock Text="数据缓冲区 · HEX" Style="{StaticResource FieldLabelStyle}"
                                           VerticalAlignment="Center" Margin="0,0,16,0" />
                                <TextBlock Text="读取长度" Style="{StaticResource FieldLabelStyle}"
                                           VerticalAlignment="Center" Margin="0,0,6,0" />
                                <ui:TextBox x:Name="TxtReadSize" Text="8" Width="64" Margin="0,0,12,0"
                                            TextChanged="TxtReadSize_TextChanged" LostFocus="DataInput_LostFocus" />
                                <CheckBox x:Name="ChkWriteRead" Content="写后读取"
                                          VerticalAlignment="Center" Margin="0,0,14,0" />
                                <ui:Button x:Name="BtnRead" Content="读取" Click="BtnRead_Click" IsEnabled="False"
                                           Width="72" Margin="0,0,6,0"
                                           ToolTip="读取数据 (Ctrl+R)" />
                                <ui:Button x:Name="BtnWrite" Content="写入" Appearance="Primary" IsEnabled="False"
                                           Click="BtnWrite_Click" Width="72"
                                           ToolTip="写入数据 (Ctrl+W)" />
                                </WrapPanel>
                            </Border>
                        </WrapPanel>

                        <ui:TextBox x:Name="TxtDataBuffer" Grid.Row="2" Text="DE AD BE EF"
                                    FontFamily="Consolas" FontSize="14" AcceptsReturn="True"
                                    TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                                    VerticalContentAlignment="Top" TextChanged="TxtDataBuffer_TextChanged"
                                    LostFocus="DataInput_LostFocus"
                                    PlaceholderText="输入待写数据；读取结果会显示在这里" />

                        <DockPanel Grid.Row="3" Margin="2,5,0,0">
                            <TextBlock x:Name="TxtBufferMeta" Text="4 字节 · 待写数据" DockPanel.Dock="Right"
                                       FontSize="11" Opacity="0.5" />
                            <TextBlock x:Name="TxtDataStatus" Text="输入数据后写入，或直接读取"
                                       FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </Grid>
                </ui:Card>
            </Grid>
        </Grid>
    </DockPanel>
</UserControl>

<UserControl x:Class="GinkgoHost.Views.ConsolePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <DockPanel Margin="12,8,12,20">
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="控制台" Style="{StaticResource PageTitleStyle}" />
                <TextBlock Style="{StaticResource PageSubtitleStyle}"
                           Text="输入 help 查看帮助 · 使用 ↑/↓ 浏览历史记录" />
            </StackPanel>
            <ui:Button Grid.Column="1" Content="清空输出" Click="BtnClearOutput_Click"
                       VerticalAlignment="Top" Margin="0,4,0,0" />
        </Grid>
        <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
            <TextBlock x:Name="TxtConsoleState" Text="就绪" DockPanel.Dock="Right"
                       VerticalAlignment="Center" Margin="12,0,0,0"
                       FontSize="11" Opacity="0.55" />
            <TextBlock Text="&gt;" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,6,0"
                       Foreground="#9a86fd" />
            <ui:TextBox x:Name="TxtIn" FontFamily="Consolas" KeyDown="TxtIn_KeyDown"
                        PlaceholderText="输入命令，回车执行" />
        </DockPanel>
        <ListBox x:Name="LstOut" FontFamily="Consolas" FontSize="13"
                 Background="{DynamicResource ControlFillColorSecondaryBrush}"
                 BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                 BorderThickness="1" Padding="12">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Line}" Foreground="{Binding Brush}" TextWrapping="Wrap" />
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</UserControl>

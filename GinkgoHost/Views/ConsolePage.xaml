<UserControl x:Class="GinkgoHost.Views.ConsolePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <Style x:Key="QuickCommandStyle" TargetType="ui:Button">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="10,1" />
            <Setter Property="FontSize" Value="11" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="12,8,12,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Padding="12,10" Margin="0,0,0,8" CornerRadius="8"
                Background="#303030" BorderBrush="#484848" BorderThickness="1">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="命令控制台" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="输入 help 查看帮助 · ↑/↓ 浏览历史 · Enter 运行"
                           FontSize="11" Opacity="0.58" Margin="0,3,0,0" />
                <WrapPanel Margin="0,9,0,0">
                    <ui:Button Content="状态" Tag="status" Click="BtnQuickCommand_Click" Style="{StaticResource QuickCommandStyle}" Margin="0,0,6,0" />
                    <ui:Button Content="扫描总线" Tag="scan" Click="BtnQuickCommand_Click" Style="{StaticResource QuickCommandStyle}" Margin="0,0,6,0" />
                    <ui:Button Content="帮助" Tag="help" Click="BtnQuickCommand_Click" Style="{StaticResource QuickCommandStyle}" Margin="0,0,6,0" />
                    <ui:Button Content="停止轮询" Tag="stop" Click="BtnQuickCommand_Click" Style="{StaticResource QuickCommandStyle}" />
                </WrapPanel>
            </StackPanel>
            <ui:Button Grid.Column="1" Content="清空输出" Click="BtnClearOutput_Click"
                       VerticalAlignment="Top" Margin="0,4,0,0" />
        </Grid>
        </Border>
        <Border Grid.Row="2" Margin="0,8,0,0" Padding="9,8" CornerRadius="8"
                Background="#303030" BorderBrush="#484848" BorderThickness="1">
        <DockPanel>
            <ui:Button x:Name="BtnRun" Content="运行" Appearance="Primary" Click="BtnRun_Click"
                       DockPanel.Dock="Right" MinWidth="72" Margin="8,0,0,0" />
            <TextBlock x:Name="TxtConsoleState" Text="就绪" DockPanel.Dock="Right"
                       VerticalAlignment="Center" Margin="12,0,0,0"
                       FontSize="11" Opacity="0.55" />
            <TextBlock Text="&gt;_" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,8,0"
                       Foreground="#9a86fd" />
            <ui:TextBox x:Name="TxtIn" FontFamily="Consolas" KeyDown="TxtIn_KeyDown"
                        PlaceholderText="输入命令，例如：read 50 00 8" />
        </DockPanel>
        </Border>
        <Border Grid.Row="1" Padding="6" CornerRadius="8"
                Background="#252525" BorderBrush="#484848" BorderThickness="1">
        <ListBox x:Name="LstOut" FontFamily="Consolas" FontSize="13"
                 Background="Transparent" BorderThickness="0" Padding="4">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,1" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{Binding Brush}" BorderThickness="2,0,0,0" Padding="9,4" Margin="0,1"
                            Background="#0DFFFFFF" CornerRadius="0,4,4,0">
                        <TextBlock Text="{Binding Line}" Foreground="{Binding Brush}" TextWrapping="Wrap" />
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        </Border>
    </Grid>
</UserControl>

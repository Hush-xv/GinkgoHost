<UserControl x:Class="GinkgoHost.Views.ConsolePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <!-- 快捷操作是次级命令：圆角 + 透明底 + 细描边，避免比主操作「运行」更抢眼。 -->
        <Style x:Key="QuickCommandStyle" TargetType="ui:Button">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>
        <Style x:Key="QuickGhostStyle" TargetType="ui:Button" BasedOn="{StaticResource QuickCommandStyle}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </UserControl.Resources>
    <Grid Margin="{StaticResource PageContentMargin}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Padding="16,14" Margin="0,0,0,12" Style="{StaticResource SubtleSurfaceStyle}">
            <StackPanel>
                <DockPanel LastChildFill="False">
                    <Border DockPanel.Dock="Right" Padding="7,2" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                        <TextBlock x:Name="TxtConsoleSession" Text="未连接 · 空闲 · 历史 0" FontSize="10" Opacity="0.76" />
                    </Border>
                    <TextBlock Text="命令控制台" FontSize="17" FontWeight="SemiBold" />
                </DockPanel>
                <TextBlock Text="输入时自动校验 · ↑/↓ 浏览历史 · Esc 停止轮询 · Enter 运行 · Ctrl+4"
                           FontSize="11" Opacity="0.58" Margin="0,3,0,0" TextWrapping="Wrap" />
                <TextBlock Text="快捷操作" FontSize="10" Opacity="0.48" Margin="0,9,0,0" />
                <WrapPanel Margin="0,4,0,0">
                    <ui:Button Content="状态" Tag="status" Click="BtnQuickCommand_Click" Style="{StaticResource QuickGhostStyle}" Margin="0,0,6,6" />
                    <ui:Button Content="扫描总线" Tag="scan" Click="BtnQuickCommand_Click" Style="{StaticResource QuickGhostStyle}" Margin="0,0,6,6" />
                    <ui:Button Content="帮助" Tag="help" Click="BtnQuickCommand_Click" Style="{StaticResource QuickGhostStyle}" Margin="0,0,6,6" />
                    <ui:Button x:Name="BtnStopRead" Content="停止轮询" Appearance="Danger" Click="BtnStopRead_Click"
                               Style="{StaticResource QuickCommandStyle}" Margin="0,0,6,6" ToolTip="停止正在运行的周期读" />
                    <ui:Button Content="复制输出" Click="BtnCopyOutput_Click" Style="{StaticResource QuickGhostStyle}" Margin="0,0,6,6" />
                    <ui:Button Content="清空输出" Click="BtnClearOutput_Click" Style="{StaticResource QuickGhostStyle}" Margin="0,0,0,6" />
                </WrapPanel>
                <CheckBox x:Name="ChkFollowOutput" Content="跟随最新输出" IsChecked="True"
                          Checked="ChkFollowOutput_Changed" Unchecked="ChkFollowOutput_Changed"
                          FontSize="11" Opacity="0.72" Margin="0,2,0,0" />
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Margin="0,12,0,0" Padding="12,10" Style="{StaticResource SubtleSurfaceStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="&gt;_" FontFamily="Consolas" VerticalAlignment="Center" Margin="0,0,8,0"
                       Foreground="{DynamicResource AccentFillColorDefaultBrush}" />
            <ui:TextBox x:Name="TxtIn" Grid.Column="1" FontFamily="Consolas"
                        TextChanged="TxtIn_TextChanged" PlaceholderText="输入命令，例如：read 50 00 8" />
            <ui:Button x:Name="BtnRun" Grid.Column="2" Content="运行" Appearance="Primary" Click="BtnRun_Click"
                       MinWidth="72" Margin="8,0,0,0" />
            <TextBlock x:Name="TxtConsoleState" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="就绪"
                       VerticalAlignment="Center" Margin="0,5,0,0" FontSize="11" Opacity="0.72"
                       TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Grid>
        </Border>
        <Border Grid.Row="1" Padding="8" Style="{StaticResource SubtleSurfaceStyle}">
        <ListBox x:Name="LstOut" FontFamily="Consolas" FontSize="13"
                 Background="Transparent" BorderThickness="0" Padding="4"
                 VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="0,1" />
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{Binding Brush}" BorderThickness="2,0,0,0" Padding="9,4" Margin="0,1"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="0,6,6,0">
                        <TextBlock Text="{Binding Line}" Foreground="{Binding Brush}" TextWrapping="Wrap" />
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="GinkgoHost.Views.ConnectBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <ui:Card Margin="0,0,0,10">
        <DockPanel>
            <!-- 状态圆点：绿=已连接，灰=未连接 -->
            <Ellipse x:Name="DotState" Width="12" Height="12" Fill="#757575"
                     VerticalAlignment="Center" Margin="14,0,10,0" />
            <StackPanel VerticalAlignment="Center" Margin="0,0,12,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="TxtState" Text="Connect to a Host Adapter"
                               VerticalAlignment="Center" />
                    <Border x:Name="BadgeState" CornerRadius="4" Padding="7,1" Margin="10,0,0,0"
                            VerticalAlignment="Center" Background="#339E9E9E" Visibility="Collapsed">
                        <TextBlock x:Name="TxtBadge" Text="ONLINE" FontSize="11" FontWeight="SemiBold"
                                   FontFamily="Consolas" Foreground="#81C784" />
                    </Border>
                </StackPanel>
                <TextBlock x:Name="TxtDetail" FontSize="11" Opacity="0.55" Margin="0,2,0,0" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button x:Name="BtnConnect" Content="连接适配器" Appearance="Primary"
                           Click="BtnConnect_Click" Margin="0,0,8,0" MinWidth="104" />
                <ui:Button x:Name="BtnDisconnect" Content="断开" Click="BtnDisconnect_Click" MinWidth="76" />
            </StackPanel>
        </DockPanel>
    </ui:Card>
</UserControl>

<UserControl x:Class="GinkgoHost.Views.LogPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <!-- 方向徽章：RX 紫 / TX 橙 / SYS 灰 -->
        <Style x:Key="DirChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="#339E9E9E" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Dir}" Value="RX">
                    <Setter Property="Background" Value="#339A86FD" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Dir}" Value="TX">
                    <Setter Property="Background" Value="#33FFA726" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="DirText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#9E9E9E" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Dir}" Value="RX">
                    <Setter Property="Foreground" Value="#C4B9FE" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Dir}" Value="TX">
                    <Setter Property="Foreground" Value="#FFD180" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 结果胶囊：OK 绿 / ERR 红 -->
        <Style x:Key="RetChip" TargetType="Border">
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Background" Value="#33EF5350" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Ok}" Value="True">
                    <Setter Property="Background" Value="#334CAF50" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="RetText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#EF5350" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Ok}" Value="True">
                    <Setter Property="Foreground" Value="#81C784" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="8,4,4,12">
        <DockPanel DockPanel.Dock="Top" Margin="4,0,0,8" LastChildFill="False">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="事务日志" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" Margin="0" />
                <TextBlock x:Name="TxtCount" VerticalAlignment="Center" Margin="10,0,0,0" Opacity="0.55" />
                <TextBlock x:Name="TxtFeedback" VerticalAlignment="Center" Margin="10,0,0,0"
                           Foreground="#81C784" FontSize="11" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                <CheckBox x:Name="ChkFollow" Content="跟随最新" IsChecked="True"
                          Checked="ChkFollow_Changed" Unchecked="ChkFollow_Changed"
                          VerticalAlignment="Center" Margin="0,0,12,0" />
                <ui:Button x:Name="BtnClear" Content="清空" Click="BtnClear_Click" Margin="0,0,8,0" />
                <ui:Button x:Name="BtnExport" Content="导出 CSV" Click="BtnExport_Click" />
            </StackPanel>
        </DockPanel>

        <Border x:Name="LogFrame" CornerRadius="6" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1" Background="{DynamicResource ControlFillColorSecondaryBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition />
                </Grid.RowDefinitions>

                <!-- 表头（列宽与行模板保持一致） -->
                <Border Padding="8,6" BorderBrush="#22FFFFFF" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="84" />
                            <ColumnDefinition Width="46" />
                            <ColumnDefinition Width="92" />
                            <ColumnDefinition Width="58" />
                            <ColumnDefinition Width="62" />
                            <ColumnDefinition Width="70" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="时间" FontSize="11" Opacity="0.5" />
                        <TextBlock Text="方向" Grid.Column="1" FontSize="11" Opacity="0.5" />
                        <TextBlock Text="操作" Grid.Column="2" FontSize="11" Opacity="0.5" />
                        <TextBlock Text="地址" Grid.Column="3" FontSize="11" Opacity="0.5" />
                        <TextBlock Text="结果" Grid.Column="4" FontSize="11" Opacity="0.5" />
                        <TextBlock Text="耗时" Grid.Column="5" FontSize="11" Opacity="0.5" />
                        <TextBlock Text="数据（双击行复制）" Grid.Column="6" FontSize="11" Opacity="0.5" />
                    </Grid>
                </Border>

                <ListBox x:Name="Lst" Grid.Row="1" FontSize="13" BorderThickness="0" Background="Transparent"
                         AlternationCount="2" ScrollViewer.HorizontalScrollBarVisibility="Auto"
                         SelectionChanged="Lst_SelectionChanged"
                         PreviewMouseDoubleClick="Lst_DoubleClick" ToolTip="单击查看记录；双击复制数据">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="MinHeight" Value="30" />
                            <Style.Triggers>
                                <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                    <Setter Property="Background" Value="#0AFFFFFF" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,3">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Ok}" Value="False">
                                                <Setter Property="Background" Value="#14EF5350" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="46" />
                                    <ColumnDefinition Width="92" />
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="62" />
                                    <ColumnDefinition Width="70" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Time}" Opacity="0.6" FontFamily="Consolas" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Style="{StaticResource DirChip}">
                                    <TextBlock Text="{Binding Dir}" Style="{StaticResource DirText}" />
                                </Border>
                                <TextBlock Text="{Binding Op}" Grid.Column="2" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Addr}" Grid.Column="3" FontFamily="Consolas" VerticalAlignment="Center" />
                                <Border Grid.Column="4" Style="{StaticResource RetChip}">
                                    <TextBlock Text="{Binding RetText}" Style="{StaticResource RetText}" />
                                </Border>
                                <TextBlock Grid.Column="5" FontFamily="Consolas" Opacity="0.6" VerticalAlignment="Center"
                                           Text="{Binding Ms, StringFormat={}{0:F1} ms}" />
                                <TextBlock Text="{Binding HexGrouped}" Grid.Column="6" FontFamily="Consolas" FontSize="12"
                                           Foreground="#C4B9FE" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           ToolTipService.ToolTip="{Binding HexGrouped}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 空态提示 -->
                <TextBlock Grid.Row="1" Text="暂无事务记录&#x0a;连接适配器后，可从“扫描总线”或“读取”开始"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Opacity="0.42" TextAlignment="Center" LineHeight="22" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasItems, ElementName=Lst}" Value="False">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>

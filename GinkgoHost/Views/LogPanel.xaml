<UserControl x:Class="GinkgoHost.Views.LogPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <!-- 协议语义色（稳定 token）：READ 蓝 #53A9FD / WRITE 橙 #FFB45B / OK 绿 #58C667 / ERR 红 #FF6D7F。
             badge 一律低透明底 + 同色文字，不做高饱和填充；方向弱化为色点。 -->
        <Style x:Key="TagBase" TargetType="Border">
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TagText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- 操作类型：主要事务标识，低透明语义底 + 语义色文字 -->
        <Style x:Key="OpChip" TargetType="Border" BasedOn="{StaticResource TagBase}">
            <Setter Property="Background" Value="#1F8A8A8A" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Dir}" Value="RX"><Setter Property="Background" Value="#1D53A9FD" /></DataTrigger>
                <DataTrigger Binding="{Binding Dir}" Value="TX"><Setter Property="Background" Value="#1DFFB45B" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OpText" TargetType="TextBlock" BasedOn="{StaticResource TagText}">
            <Setter Property="Foreground" Value="#C9C9C9" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Dir}" Value="RX"><Setter Property="Foreground" Value="#7CBCFD" /></DataTrigger>
                <DataTrigger Binding="{Binding Dir}" Value="TX"><Setter Property="Foreground" Value="#FFC684" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AddrText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="#9A9A9A" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- 状态：正常 OK 只用轻量绿字（高倍日志下避免满屏绿块）；ERR 红底 badge 保证异常一眼可见 -->
        <Style x:Key="ResultChip" TargetType="Border" BasedOn="{StaticResource TagBase}">
            <Setter Property="Background" Value="#1AFF6D7F" />
            <Setter Property="Padding" Value="7,2" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Ok}" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Padding" Value="0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Dir}" Value="SYS">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ResultText" TargetType="TextBlock" BasedOn="{StaticResource TagText}">
            <Setter Property="Foreground" Value="#FF6D7F" />
            <Style.Triggers><DataTrigger Binding="{Binding Ok}" Value="True"><Setter Property="Foreground" Value="#58C667" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="MsText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#787878" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Dir}" Value="SYS"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 事务流筛选 chip：弱化视觉（透明底/细描边/小号），与一级功能模式按钮拉开层级。 -->
        <Style x:Key="FilterPill" TargetType="ui:Button">
            <Setter Property="Height" Value="22" /><Setter Property="FontSize" Value="10.5" />
            <Setter Property="Padding" Value="8,1" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="#30FFFFFF" />
            <Setter Property="Foreground" Value="#A0A0A0" />
        </Style>
        <Style x:Key="LogHeaderButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="8,6" />
            <Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="#C9C9C9" />
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#16FFFFFF" /><Setter Property="Foreground" Value="#D7E5FF" /></Trigger></Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="8,2,4,8">
        <Grid DockPanel.Dock="Top" Margin="4,0,0,6">
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="事务流" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                <TextBlock Text="实时" Margin="8,0,0,0" FontSize="11" Foreground="#91D5A0" VerticalAlignment="Center" />
                <TextBlock x:Name="TxtCount" Margin="8,0,0,0" Opacity="0.55" VerticalAlignment="Center" />
                <TextBlock x:Name="TxtFeedback" Margin="10,0,0,0" Foreground="#91D5A0" FontSize="11" VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0">
                    <ui:Button x:Name="BtnFilterAll" Content="全部" Tag="all" Click="BtnFilter_Click" Style="{StaticResource FilterPill}" />
                    <ui:Button x:Name="BtnFilterRead" Content="读取" Tag="read" Click="BtnFilter_Click" Style="{StaticResource FilterPill}" />
                    <ui:Button x:Name="BtnFilterWrite" Content="写入" Tag="write" Click="BtnFilter_Click" Style="{StaticResource FilterPill}" />
                    <ui:Button x:Name="BtnFilterSystem" Content="系统" Tag="system" Click="BtnFilter_Click" Style="{StaticResource FilterPill}" />
                    <ui:Button x:Name="BtnFilterError" Content="失败" Tag="error" Click="BtnFilter_Click" Style="{StaticResource FilterPill}" />
                </StackPanel>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <CheckBox x:Name="ChkFollow" Content="跟随最新" IsChecked="True" Checked="ChkFollow_Changed" Unchecked="ChkFollow_Changed" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ui:Button x:Name="BtnClear" Content="清空" Click="BtnClear_Click" Margin="0,0,6,0" />
                <ui:Button x:Name="BtnExport" Content="导出 CSV" Click="BtnExport_Click" />
            </StackPanel>
        </Grid>

        <Border x:Name="LogFrame" Background="#252525" BorderBrush="#3D3D3D" BorderThickness="1" CornerRadius="5">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <!-- 平面表头：信息层级由列与细分隔线承担，不再额外套卡片。 -->
                <Border Background="#363636" BorderBrush="#505050" BorderThickness="0,0,0,1">
                    <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="230" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Button Content="时间" Tag="Ts" Click="BtnSort_Click" Style="{StaticResource LogHeaderButton}" />
                                <Button Content="操作" Tag="Op" Grid.Column="1" Click="BtnSort_Click" Style="{StaticResource LogHeaderButton}" />
                                <Button Content="地址" Tag="Addr" Grid.Column="2" Click="BtnSort_Click" Style="{StaticResource LogHeaderButton}" />
                                <Button Content="状态" Tag="RetText" Grid.Column="3" Click="BtnSort_Click" Style="{StaticResource LogHeaderButton}" />
                                <Button Content="耗时" Tag="Ms" Grid.Column="4" Click="BtnSort_Click" Style="{StaticResource LogHeaderButton}" />
                                <Button Content="数据 HEX（双击记录复制）" Tag="HexGrouped" Grid.Column="5" Click="BtnSort_Click" Style="{StaticResource LogHeaderButton}" />
                    </Grid>
                </Border>

                <ListBox x:Name="Lst" Grid.Row="1" FontSize="13" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="Lst_SelectionChanged" PreviewMouseDoubleClick="Lst_DoubleClick" ToolTip="单击查看记录；双击复制数据">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="MinHeight" Value="34" />
                            <Setter Property="BorderBrush" Value="#333333" /><Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#0AFFFFFF" /></Trigger>
                                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="#243E67A8" /><Setter Property="BorderBrush" Value="#6686B8FF" /></Trigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="84" />
                                    <ColumnDefinition Width="230" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="60" />
                                    <ColumnDefinition Width="64" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Time}" FontFamily="Consolas" FontSize="12" Opacity="0.62" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Style="{StaticResource OpChip}" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Op}" Style="{StaticResource OpText}" />
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding Addr}" Style="{StaticResource AddrText}" />
                                <Border Grid.Column="3" Style="{StaticResource ResultChip}" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding RetText}" Style="{StaticResource ResultText}" />
                                </Border>
                                <TextBlock Grid.Column="4" Text="{Binding Ms, StringFormat={}{0:F1} ms}" Style="{StaticResource MsText}" />
                                <TextBlock Grid.Column="5" Text="{Binding HexGrouped}" FontFamily="Consolas" FontSize="13"
                                           Foreground="#D8DEE6" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           ToolTipService.ToolTip="{Binding HexGrouped}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border x:Name="SelectedRecordPanel" Grid.Row="2" Padding="10,6" Background="#0AFFFFFF" BorderBrush="#20FFFFFF" BorderThickness="0,1,0,0" Visibility="Collapsed">
                    <DockPanel>
                        <TextBlock x:Name="TxtSelectedData" DockPanel.Dock="Right" FontFamily="Consolas" Foreground="#BFCBFF" TextTrimming="CharacterEllipsis" MaxWidth="460" />
                        <TextBlock x:Name="TxtSelectedSummary" Opacity="0.72" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </Border>

                <TextBlock Grid.Row="1" Text="暂无事务记录&#x0a;连接适配器后，可从“扫描总线”或“读取”开始" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0.42" TextAlignment="Center" LineHeight="22" IsHitTestVisible="False">
                    <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=Lst}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>

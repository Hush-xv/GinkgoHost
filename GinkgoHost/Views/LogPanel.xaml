<UserControl x:Class="GinkgoHost.Views.LogPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <UserControl.Resources>
        <!-- 协议语义色（稳定 token）：READ 蓝 #53A9FD / WRITE 橙 #FFB45B / OK 绿 #58C667 / ERR 红 #FF6D7F。
             badge 一律低透明底 + 同色文字，不做高饱和填充；方向弱化为色点。 -->
        <Style x:Key="TagBase" TargetType="Border">
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="Padding" Value="7,2" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="TagText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- 操作类型：主要事务标识，低透明语义底 + 语义色文字 -->
        <Style x:Key="OpChip" TargetType="Border" BasedOn="{StaticResource TagBase}">
            <Setter Property="Background" Value="#1F8A8A8A" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Dir}" Value="RX"><Setter Property="Background" Value="#1D53A9FD" /></DataTrigger>
                <DataTrigger Binding="{Binding Dir}" Value="TX"><Setter Property="Background" Value="#1DFFB45B" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="OpText" TargetType="TextBlock" BasedOn="{StaticResource TagText}">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Dir}" Value="RX"><Setter Property="Foreground" Value="{DynamicResource RxAccentBrush}" /></DataTrigger>
                <DataTrigger Binding="{Binding Dir}" Value="TX"><Setter Property="Foreground" Value="{DynamicResource TxAccentBrush}" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AddrText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- 状态：正常 OK 只用轻量绿字（高倍日志下避免满屏绿块）；ERR 红底 badge 保证异常一眼可见 -->
        <Style x:Key="ResultChip" TargetType="Border" BasedOn="{StaticResource TagBase}">
            <Setter Property="Background" Value="#1AFF6D7F" />
            <Setter Property="Padding" Value="7,2" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Ok}" Value="True">
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Padding" Value="0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Dir}" Value="SYS">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="ResultText" TargetType="TextBlock" BasedOn="{StaticResource TagText}">
            <Setter Property="Foreground" Value="{DynamicResource ErrAccentBrush}" />
            <Style.Triggers><DataTrigger Binding="{Binding Ok}" Value="True"><Setter Property="Foreground" Value="{DynamicResource OkAccentBrush}" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="MsText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#787878" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Dir}" Value="SYS"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 事务流筛选 chip：弱化视觉（透明底/细描边/小号），与一级功能模式按钮拉开层级。 -->
        <Style x:Key="FilterPill" TargetType="ui:Button">
            <Setter Property="Height" Value="22" /><Setter Property="FontSize" Value="10.5" />
            <Setter Property="Padding" Value="9,1" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="LogHeaderButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="8,6" />
            <Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" /><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" /></Trigger></Style.Triggers>
        </Style>
    </UserControl.Resources>

    <DockPanel Margin="12,4,8,12">
        <!-- 工具栏按可用宽度流式换行，窄窗不再挤压筛选或导出动作。 -->
        <WrapPanel DockPanel.Dock="Top" Margin="4,0,0,6" VerticalAlignment="Center">
            <WrapPanel VerticalAlignment="Center" Margin="0,0,12,4">
                <TextBlock Text="事务证据流" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                <TextBlock Text="实时" Margin="8,0,0,0" FontSize="11" Foreground="{DynamicResource StatusLiveBrush}" VerticalAlignment="Center" />
                <TextBlock x:Name="TxtCount" Margin="8,0,0,0" Opacity="0.55" VerticalAlignment="Center" />
                <TextBlock x:Name="TxtFeedback" Margin="10,0,0,0" Foreground="{DynamicResource StatusSuccessBrush}" FontSize="11" VerticalAlignment="Center" />
                <TextBlock x:Name="TxtSortState" Margin="8,0,0,0" Opacity="0.48" FontSize="10.5" VerticalAlignment="Center" />
                <Border x:Name="FailureLens" Visibility="Collapsed" Margin="10,0,0,0" Padding="7,2" CornerRadius="5"
                        Background="#20FF6D7F" BorderBrush="#58FF6D7F" BorderThickness="1">
                    <TextBlock x:Name="TxtFailureLens" FontSize="10.5" Foreground="{DynamicResource ErrAccentBrush}" VerticalAlignment="Center" />
                </Border>
                <Border Margin="14,0,0,0" Padding="2" CornerRadius="6" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal">
                        <ui:Button x:Name="BtnFilterAll" Content="全部" Tag="all" Click="BtnFilter_Click" Style="{StaticResource FilterPill}" />
                        <ui:Button x:Name="BtnFilterRead" Content="读取" Tag="read" Click="BtnFilter_Click" Style="{StaticResource FilterPill}" />
                        <ui:Button x:Name="BtnFilterWrite" Content="写入" Tag="write" Click="BtnFilter_Click" Style="{StaticResource FilterPill}" />
                        <ui:Button x:Name="BtnFilterSystem" Content="系统" Tag="system" Click="BtnFilter_Click" Style="{StaticResource FilterPill}" />
                        <ui:Button x:Name="BtnFilterError" Content="失败" Tag="error" Click="BtnFilter_Click" Style="{StaticResource FilterPill}" />
                    </StackPanel>
                </Border>
            </WrapPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                <CheckBox x:Name="ChkFollow" Content="跟随最新" IsChecked="True" Checked="ChkFollow_Changed" Unchecked="ChkFollow_Changed" VerticalAlignment="Center" Margin="0,0,10,0" />
                <ui:Button x:Name="BtnResetFilter" Content="查看全部" Click="BtnResetFilter_Click" Visibility="Collapsed" Margin="0,0,6,0" />
                <ui:Button x:Name="BtnClear" Click="BtnClear_Click" Margin="0,0,6,0" ToolTip="清空当前全部事务记录">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Margin="0,0,5,0" />
                        <TextBlock Text="清空" VerticalAlignment="Center" />
                    </StackPanel>
                </ui:Button>
                <ui:Button x:Name="BtnExport" Click="BtnExport_Click" ToolTip="导出当前筛选下的事务记录为 CSV">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowExportLtr24" FontSize="14" Margin="0,0,5,0" />
                        <TextBlock Text="导出 CSV" VerticalAlignment="Center" />
                    </StackPanel>
                </ui:Button>
            </StackPanel>
        </WrapPanel>

        <Border x:Name="LogFrame" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="10"
                Effect="{StaticResource CardShadow}">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <!-- 平面表头：信息层级由列与细分隔线承担，不再额外套卡片。 -->
                <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="66" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Button x:Name="BtnSortTime" Content="时间" Tag="Ts" Click="BtnSort_Click" Style="{StaticResource LogHeaderButton}" />
                                <Button x:Name="BtnSortOp" Content="操作" Tag="Op" Grid.Column="1" Click="BtnSort_Click" Style="{StaticResource LogHeaderButton}" />
                                <Button x:Name="BtnSortAddress" Content="地址" Tag="Addr" Grid.Column="2" Click="BtnSort_Click" Style="{StaticResource LogHeaderButton}" />
                                <Button x:Name="BtnSortStatus" Content="状态" Tag="RetText" Grid.Column="3" Click="BtnSort_Click" Style="{StaticResource LogHeaderButton}" />
                                <Button x:Name="BtnSortData" Content="数据预览" Tag="HexGrouped" Grid.Column="4" Click="BtnSort_Click" Style="{StaticResource LogHeaderButton}" ToolTip="选中行后在底部查看完整数据与耗时" />
                    </Grid>
                </Border>

                <ListBox x:Name="Lst" Grid.Row="1" FontSize="13" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel"
                         SelectionChanged="Lst_SelectionChanged" PreviewMouseDoubleClick="Lst_DoubleClick" PreviewKeyDown="Lst_PreviewKeyDown"
                         PreviewMouseRightButtonDown="Lst_PreviewMouseRightButtonDown"
                         ToolTip="单击查看完整数据；Ctrl+C 复制完整记录；双击复制数据">
                    <ListBox.ContextMenu>
                        <ContextMenu Opened="Lst_ContextMenuOpened">
                            <MenuItem x:Name="MnuCopyRecord" Header="复制完整记录" Click="MnuCopyRecord_Click" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="0" /><Setter Property="MinHeight" Value="34" />
                            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" /><Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" /></Trigger>
                                <Trigger Property="IsSelected" Value="True"><Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" /></Trigger>
                                <DataTrigger Binding="{Binding Ok}" Value="False">
                                    <Setter Property="BorderBrush" Value="{DynamicResource StatusErrorBrush}" />
                                    <Setter Property="BorderThickness" Value="3,0,0,1" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="8,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="58" />
                                    <ColumnDefinition Width="66" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Time}" FontFamily="Consolas" FontSize="12" Opacity="0.62" VerticalAlignment="Center" />
                                <Border Grid.Column="1" Style="{StaticResource OpChip}" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding Op}" Style="{StaticResource OpText}" />
                                </Border>
                                <TextBlock Grid.Column="2" Text="{Binding Addr}" Style="{StaticResource AddrText}" />
                                <Border Grid.Column="3" Style="{StaticResource ResultChip}" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding RetText}" Style="{StaticResource ResultText}" />
                                </Border>
                                <TextBlock Grid.Column="4" Text="{Binding DataDisplay}" FontFamily="Consolas" FontSize="13"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"
                                           ToolTipService.ToolTip="{Binding DataDisplay}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border x:Name="SelectedRecordPanel" Grid.Row="2" Padding="10,7" Background="{DynamicResource ControlFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <DockPanel LastChildFill="True">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                                <TextBlock Text="完整数据 · Ctrl+C" FontSize="11" Opacity="0.52" VerticalAlignment="Center" Margin="0,0,7,0" />
                                <ui:Button x:Name="BtnCopySelected" Content="复制" Click="BtnCopySelected_Click" FontSize="10" Padding="7,1" ToolTip="复制当前记录完整信息" />
                            </StackPanel>
                            <TextBlock x:Name="TxtSelectedSummary" Opacity="0.72" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <Border Grid.Row="1" Margin="0,5,0,0" Padding="7,4" Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="6">
                            <ScrollViewer MaxHeight="72" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly">
                                <TextBlock x:Name="TxtSelectedData" FontFamily="Consolas" Foreground="{DynamicResource TextFillColorPrimaryBrush}" TextWrapping="Wrap" />
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" TextBlock.TextAlignment="Center">
                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=Lst}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <ui:SymbolIcon Symbol="ArrowClockwise24" FontSize="34" Opacity="0.30" HorizontalAlignment="Center" />
                    <TextBlock Text="暂无事务记录" FontSize="13" FontWeight="SemiBold" Opacity="0.55" Margin="0,8,0,0" />
                    <TextBlock Text="连接适配器后，可从“扫描总线”或“读取”开始" FontSize="11" Opacity="0.42" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </DockPanel>
</UserControl>

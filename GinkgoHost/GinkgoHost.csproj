<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Ginkgo_Driver.dll x64 v2.0.3.6，进程必须 x64 -->
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>GinkgoHost</RootNamespace>
    <Version>0.9.6</Version>
    <InformationalVersion>0.9.6-beta</InformationalVersion>
    <ApplicationIcon>Assets\GinkgoHost.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WPF-UI" Version="3.0.5" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\GinkgoHost.ico" />
    <!-- 冒烟测试独立编译，不并入主工程 -->
    <Compile Remove="tests/**/*.cs" />
    <Content Include="libs\x64\Ginkgo_Driver.dll">
      <Link>Ginkgo_Driver.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Total Phase Aardvark API DLL x64 v6.00。官方 zip 分发件节表 rawsz 被清零（不可加载），
         此文件已按相邻节指针差值修复节大小；详见 Native/AardvarkI2c.cs。 -->
    <Content Include="libs\x64\aardvark.dll">
      <Link>aardvark.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
